      workbench.dataset.collapsed = collapsed ? "false" : "true";
      collapseTreeButton.textContent = collapsed ? "‹" : "›";
      collapseTreeButton.title = collapsed ? "收拢左侧" : "展开左侧";
      localStorage.setItem("nkustudy-admin-tree-collapsed", String(!collapsed));
    });

    resizer.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      resizer.setPointerCapture(event.pointerId);
      const move = (moveEvent) => {
        const left = workbench.getBoundingClientRect().left;
        setTreeWidth(moveEvent.clientX - left);
      };
      const up = () => {
        resizer.removeEventListener("pointermove", move);
        resizer.removeEventListener("pointerup", up);
      };
      resizer.addEventListener("pointermove", move);
      resizer.addEventListener("pointerup", up);
    });
