    function renderDonateRecords() {
      if (!donateRecordsEditor) return;
      if (!Array.isArray(donateState.records)) donateState.records = [];
      donateRecordsEditor.innerHTML = "";
      const ensure = (row) => {
        if (!row || typeof row !== "object") return { date: "", nickname: "", usage: "" };
