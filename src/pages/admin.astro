        <thead><tr><th style="width: 34%;">名称</th><th style="width: 10%;">状态</th><th style="width: 20%;">用途</th><th style="width: 12%;">签名</th><th style="width: 24%;">操作</th></tr></thead>
        <tbody></tbody>
      `;
      const body = table.querySelector("tbody");
      for (const bot of notifyState.bots) {
        const row = document.createElement("tr");
        row.innerHTML = `
          <td style="width: 34%;">${escapeHtml(bot.name)}<br /><span class="muted" style="font-size:0.78em;">${escapeHtml(bot.webhookUrl.slice(0, 46))}…</span></td>
          <td style="width: 10%;">${bot.enabled ? "启用" : "停用"}</td>
          <td style="width: 20%;">${(bot.purposes || ["moderation"]).map((purpose) => purpose === "moderation" ? "待审通知" : purpose === "ops" ? "运行告警" : "每日汇总").join(" + ")}</td>
          <td style="width: 12%;">${bot.signSecretConfigured ? "已配置" : "未配置"}</td>
          <td style="width: 24%;" class="admin-table-ops"></td>
