    function checkboxField(label, value, onInput) {
      const wrap = document.createElement("label");
      wrap.className = "admin-check-field";
      const input = document.createElement("input");
      input.type = "checkbox";
      input.checked = Boolean(value);
      input.addEventListener("change", () => onInput(input.checked));
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      wrap.append(input, labelEl);
      return wrap;
    }

    function numberField(label, value, onInput) {
      const wrap = field(label, value, (next) => onInput(Number(next || 0)));
      wrap.querySelector("input").type = "number";
      wrap.querySelector("input").min = "0";
      return wrap;
    }

    function selectField(label, value, options, onInput) {
      const wrap = document.createElement("label");
      wrap.className = "admin-field";
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      const select = document.createElement("select");
      for (const [optionValue, optionLabel] of options) {
        const option = document.createElement("option");
        option.value = optionValue;
        option.textContent = optionLabel;
        option.selected = String(value ?? "") === String(optionValue);
        select.append(option);
      }
      select.addEventListener("change", () => onInput(select.value, select));
      wrap.append(labelEl, select);
      return wrap;
    }

    function appendPagination(container, total, currentPage, onPage) {
      if (total <= adminPageSize) return;
      const pages = Math.max(1, Math.ceil(total / adminPageSize));
      const pager = document.createElement("div");
      pager.className = "pagination";
      const prev = document.createElement("button");
      prev.type = "button";
      prev.className = "button secondary";
      prev.textContent = "上一页";
      prev.disabled = currentPage <= 1;
      prev.addEventListener("click", () => onPage(currentPage - 1));
      const next = document.createElement("button");
      next.type = "button";
      next.className = "button secondary";
      next.textContent = "下一页";
      next.disabled = currentPage >= pages;
      next.addEventListener("click", () => onPage(currentPage + 1));
      const label = document.createElement("span");
      label.className = "muted";
      label.textContent = `第 ${currentPage} / ${pages} 页，共 ${total} 项`;
      pager.append(prev, label, next);
      container.append(pager);
    }

    async function saveReviewState(message = "已保存") {
      reviewAdminStatus.textContent = "保存中...";
      const data = await api("/reviews", {
        method: "POST",
        body: JSON.stringify({ data: reviewState, expectedRevision: reviewRevision }),
      });
      reviewState = data.data;
      reviewRevision = data.revision;
      reviewAdminStatus.textContent = message;
      renderReviewAdmin();
    }

    function renderReviewAdmin() {
      if (!reviewState) return;
      const rules = reviewState.rules ??= {};
      reviewRulesEditor.innerHTML = "";
      reviewRulesEditor.append(
        checkboxField("开放用户提交", rules.submissionOpen, (value) => { rules.submissionOpen = value; }),
        checkboxField("提交后需要审核", rules.moderationRequired, (value) => { rules.moderationRequired = value; }),
        checkboxField("启用 Turnstile（预留）", rules.turnstileEnabled, (value) => { rules.turnstileEnabled = value; }),
        numberField("每小时提交上限", rules.hourlyLimit ?? 3, (value) => { rules.hourlyLimit = value; }),
        numberField("每日提交上限", rules.dailyLimit ?? 10, (value) => { rules.dailyLimit = value; }),
        numberField("评价最少字数", rules.minLength ?? 12, (value) => { rules.minLength = value; }),
        markdownField("评价公告栏（支持 Markdown）", rules.announcement ?? "", (value) => { rules.announcement = value; }),
        markdownField("规则备注", rules.notes ?? "", (value) => { rules.notes = value; }, { height: 150 })
      );

      const keyword = reviewAdminSearch.value.trim().toLowerCase();
      const statusFilter = reviewStatusFilter.value;
      const reviews = (reviewState.reviews ?? []).filter((review) => {
        const text = `${review.courseTitle} ${review.teacher}`.toLowerCase();
        const status = String(review.status || "pending");
        const matchesStatus =
          statusFilter === "all" ||
          (statusFilter === "hidden" && review.hidden) ||
          (statusFilter === "visible" && !review.hidden) ||
          (statusFilter === status);
        return matchesStatus && (!keyword || text.includes(keyword));
      });

      reviewAdminList.innerHTML = "";
      if (!reviews.length) {
        reviewAdminList.innerHTML = `<p class="empty">暂无匹配评价。</p>`;
        mountMarkdownEditors(document.querySelector("#review-admin-panel"));
        return;
      }
      const reviewPages = Math.max(1, Math.ceil(reviews.length / adminPageSize));
      reviewAdminPage = Math.min(reviewAdminPage, reviewPages);
      const pageReviews = reviews.slice((reviewAdminPage - 1) * adminPageSize, reviewAdminPage * adminPageSize);

      const groupedReviews = new Map();
      for (const review of pageReviews) {
        const key = `${review.courseTitle || "未命名课程"}-${review.teacher || "未填写老师"}`;
        if (!groupedReviews.has(key)) groupedReviews.set(key, []);
        groupedReviews.get(key).push(review);
      }

      for (const [groupName, groupReviews] of groupedReviews) {
        const group = document.createElement("details");
        group.className = "resource-section review-admin-group";
        group.open = true;
        group.innerHTML = `<summary>${escapeHtml(groupName)} <span class="muted">(${groupReviews.length})</span></summary>`;
        const groupBody = document.createElement("div");
        groupBody.className = "admin-section-body";

        for (const review of groupReviews) {
        const item = document.createElement("div");
        item.className = "review-admin-item";
        item.innerHTML = `
          <div class="course-meta">
            <span class="pill">${escapeHtml(review.status || "pending")}</span>
            <span class="pill">${escapeHtml(review.hidden ? "已隐藏" : "显示中")}</span>
            <span class="pill">${escapeHtml(review.courseTitle || "")}</span>
            <span class="pill">${escapeHtml(review.teacher || "")}</span>
            <span class="pill">${"★".repeat(Number(review.rating || 0))}</span>
          </div>
          <p>${escapeHtml(review.content || "")}</p>
          <small class="muted">${escapeHtml(review.createdAt || "")}</small>
        `;
        const editForm = document.createElement("div");
        editForm.className = "admin-form admin-inline-editor";
        editForm.append(
          field("课程", review.courseTitle ?? "", (value) => {
            review.courseTitle = value.trim();
            review.updatedAt = new Date().toISOString();
          }),
          field("老师", review.teacher ?? "", (value) => {
            review.teacher = value.trim();
            review.updatedAt = new Date().toISOString();
          }),
          selectField("评分", String(review.rating ?? 5), [["5", "5 分"], ["4", "4 分"], ["3", "3 分"], ["2", "2 分"], ["1", "1 分"]], (value) => {
            review.rating = Number(value);
            review.updatedAt = new Date().toISOString();
          }),
          markdownField("评价内容", review.content ?? "", (value) => {
            review.content = value;
            review.updatedAt = new Date().toISOString();
          })
        );
        editForm.hidden = true;
        const actions = document.createElement("div");
        actions.className = "filter-row";
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "button secondary";
        edit.textContent = "编辑";
        edit.addEventListener("click", () => {
          editForm.hidden = !editForm.hidden;
          edit.textContent = editForm.hidden ? "编辑" : "收起编辑";
        });
        const approve = document.createElement("button");
        approve.type = "button";
        approve.className = "button secondary";
        approve.textContent = "通过";
        approve.addEventListener("click", async () => {
          review.status = "approved";
          review.hidden = false;
          review.updatedAt = new Date().toISOString();
          await saveReviewState("已通过并公开");
        });
        const pending = document.createElement("button");
        pending.type = "button";
        pending.className = "button secondary";
        pending.textContent = "待审";
        pending.addEventListener("click", async () => {
          review.status = "pending";
          review.updatedAt = new Date().toISOString();
          await saveReviewState("已设为待审");
        });
        const hide = document.createElement("button");
        hide.type = "button";
        hide.className = "button secondary";
        hide.textContent = review.hidden ? "取消隐藏" : "隐藏";
        hide.addEventListener("click", async () => {
          review.hidden = !review.hidden;
          review.updatedAt = new Date().toISOString();
          await saveReviewState(review.hidden ? "已隐藏" : "已取消隐藏");
        });
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "button secondary";
        remove.textContent = "删除";
        remove.addEventListener("click", async () => {
          if (!confirm("删除这条评价？")) return;
          reviewState.reviews = (reviewState.reviews ?? []).filter((item) => item.id !== review.id);
          await saveReviewState("已删除");
        });
        actions.append(edit, approve, pending, hide, remove);
        item.append(editForm, actions);
        groupBody.append(item);
        }
        group.append(groupBody);
        reviewAdminList.append(group);
      }
      appendPagination(reviewAdminList, reviews.length, reviewAdminPage, (page) => {
        reviewAdminPage = page;
