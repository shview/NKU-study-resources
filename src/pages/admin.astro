      publishStatus.textContent = "正在从 R2 同步...";
      try {
        const data = await api("/sync-r2", {
          method: "POST",
          body: JSON.stringify({ courseId: course.id, expectedRevision: manifestRevision }),
        });
        acceptManifest(data);
        selectedId = data.course.id;
        renderManifestSettings();
        renderTree();
        renderEditor();
        publishStatus.textContent = statusWithWarnings("已按 R2 更新并发布", data);
      } catch (error) {
        publishStatus.textContent = error.message;
      }
