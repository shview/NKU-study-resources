      if (app && localStorage.getItem("nkustudy-admin-nav-collapsed-all") === "1") app.dataset.navCollapsed = "1";
    })();

    /** 登录态变化后刷新置灰与当前高亮 */
    function bindAdminNavState() {
      const permissions = new Set(sessionState?.permissions || []);
      for (const item of document.querySelectorAll(".admin-nav-item")) {
        const required = tabPermissions[item.dataset.adminTab];
        const allowed = !required || permissions.has(required);
        item.classList.toggle("admin-nav-item--locked", !allowed);
        item.title = allowed ? "" : `需要「${permissionLabels[required] || required}」权限`;
        item.classList.toggle("secondary", item.dataset.adminTab !== currentAdminTab);
      }
    }

    let currentAdminTab = "resources";

    function bindAdminTabButtons() {
    document.querySelectorAll("[data-admin-tab]").forEach((button) => {
      if (button.dataset.adminTabBound === "1") return;
      button.dataset.adminTabBound = "1";
      button.addEventListener("click", async () => {
        const tab = button.dataset.adminTab;
        const required = tabPermissions[tab];
        if (required && !(sessionState?.permissions || []).includes(required)) {
          window.alert(`该页面需要「${permissionLabels[required] || required}」权限，请联系主管理员开通。`);
          return;
        }
        currentAdminTab = tab;
        for (const item of document.querySelectorAll(".admin-nav-item")) {
          item.classList.toggle("secondary", item.dataset.adminTab !== tab);
        }
        document.querySelectorAll("[data-admin-tab]").forEach((item) => {
          const active = item === button;
          item.classList.toggle("secondary", !active);
        });
        resourceAdminPanel.hidden = tab !== "resources";
        reviewAdminPanel.hidden = tab !== "reviews";
        participateAdminPanel.hidden = tab !== "participate";
        feedbackAdminPanel.hidden = tab !== "feedback";
        linksAdminPanel.hidden = tab !== "links";
        homeAdminPanel.hidden = tab !== "home";
        footerAdminPanel.hidden = tab !== "footer";
        editorSettingsAdminPanel.hidden = tab !== "editor-settings";
        statsAdminPanel.hidden = tab !== "stats";
        aboutAdminPanel.hidden = tab !== "about";
        donateAdminPanel.hidden = tab !== "donate";
        privacyAdminPanel.hidden = tab !== "privacy";
        reportsAdminPanel.hidden = tab !== "reports";
        lawAdminPanel.hidden = tab !== "law";
        backupAdminPanel.hidden = tab !== "backup";
        accountsAdminPanel.hidden = tab !== "accounts";
        mpUsersAdminPanel.hidden = tab !== "mp-users";
        serviceKeysAdminPanel.hidden = tab !== "service-keys";
        notifyAdminPanel.hidden = tab !== "notify";
        auditAdminPanel.hidden = tab !== "audit";
        if (tab === "notify" && !notifyState.loaded) {
          notifyAdminStatus.textContent = "加载中...";
          try {
            await loadNotifyAdmin();
            notifyAdminStatus.textContent = "";
          } catch (error) {
            notifyAdminStatus.textContent = error.message;
          }
        }
        aiAdminPanel.hidden = tab !== "ai";
        // 面板在 hidden 状态下渲染过的 Markdown 字段（如经举报页签后台加载的反馈数据）此时补挂载
        const adminPanelsByTab: Record<string, Element | null> = {
          resources: resourceAdminPanel, reviews: reviewAdminPanel, participate: participateAdminPanel,
          feedback: feedbackAdminPanel, links: linksAdminPanel, home: homeAdminPanel, footer: footerAdminPanel,
          editorSettings: editorSettingsAdminPanel, stats: statsAdminPanel, about: aboutAdminPanel,
          donate: donateAdminPanel, privacy: privacyAdminPanel, reports: reportsAdminPanel, law: lawAdminPanel,
          backup: backupAdminPanel, accounts: accountsAdminPanel, mpUsers: mpUsersAdminPanel,
          serviceKeys: serviceKeysAdminPanel, notify: notifyAdminPanel, audit: auditAdminPanel, ai: aiAdminPanel,
        };
        const activeAdminPanel = adminPanelsByTab[tab];
        if (activeAdminPanel) {
          requestAnimationFrame(() => mountMarkdownEditors(activeAdminPanel, "admin", { destroy: false }));
        }
        if (tab === "ai" && !aiAdminState.loaded) {
          document.querySelector("#ai-status").textContent = "加载中...";
          try {
            await loadAiAdmin();
            document.querySelector("#ai-status").textContent = "";
          } catch (error) {
            document.querySelector("#ai-status").textContent = error.message;
          }
