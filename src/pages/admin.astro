  <script>
    import Vditor from "vditor";
    import { r2SyncStatus, statusWithWarnings } from "../lib/admin-response-warnings.js";
    import { createModerationDraftStore } from "../lib/moderation-drafts.js";

    type ModerationKind = "reviews" | "feedback";
    type ModerationRules = {
      submissionOpen?: boolean;
      moderationRequired?: boolean;
      turnstileEnabled?: boolean;
      hourlyLimit?: number;
      dailyLimit?: number;
      minLength?: number;
      announcement?: string;
      notes?: string;
      submissionOptions?: { allowCustomCourse?: boolean; allowCustomTeacher?: boolean };
      keywordFilter?: { enabled?: boolean; words?: string[] };
      [key: string]: unknown;
    };
    type RulesProvenance = { hash: string; source: string; configuredAt?: string; configuredBy?: string | null };
    type ModerationRecord = {
      id: string;
      type?: string;
      title?: string;
      content?: string;
      contact?: string;
      courseTitle?: string;
      teacher?: string;
      rating?: number;
      user_id?: string | number | null;
      private?: boolean;
      hidden?: boolean;
      handlingStatus?: string;
      publicationState?: string;
      publicationBlocked?: boolean;
      publicationBlockedReason?: string;
