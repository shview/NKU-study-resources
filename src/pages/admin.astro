        const data = await api(moves.length ? "/r2-publish" : "/manifest", {
          method: "POST",
          body: JSON.stringify(manifestWriteBody({ moves })),
        });
        acceptManifest(data);
        renderTree();
        renderEditor();
        publishStatus.textContent = statusWithWarnings("已发布", data);
      } catch (error) {
        publishStatus.textContent = error.message;
      }
    });

    document.querySelector("#sync-r2").addEventListener("click", async () => {
