          renderEditor();
        });

        body.append(files, addFile);
        details.append(body);
        sections.append(details);
      });

      const addSection = document.createElement("button");
      addSection.type = "button";
      addSection.className = "button secondary";
      addSection.textContent = "新增板块";
      addSection.addEventListener("click", () => {
        course.sections ??= [];
        course.sections.push({ title: "新板块", note: "", files: [] });
        renderEditor();
      });

      form.append(sections, addSection);
      editorEl.append(form);
      mountMarkdownEditors(editorEl);
    }

