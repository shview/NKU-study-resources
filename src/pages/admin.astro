---
import Layout from "../layouts/Layout.astro";
import "vditor/dist/index.css";
---

<Layout title="内容管理" eyebrow="Admin">
  <section class="content admin-content">
    <div class="panel" id="login-panel">
      <div class="panel-header">
        <h2>后台登录</h2>
      </div>
      <div class="panel-body">
        <form class="admin-form" id="login-form">
          <label class="admin-field">
            <span>账号</span>
            <input id="admin-username" type="text" autocomplete="username" />
          </label>
          <label class="admin-field">
            <span>密码</span>
            <input id="admin-password" type="password" autocomplete="current-password" />
          </label>
          <div class="filter-row">
            <button class="button" type="submit">登录</button>
            <span class="muted" id="login-status"></span>
          </div>
        </form>
      </div>
    </div>

    <div id="admin-app" hidden>
      <div class="card" id="must-change-banner" hidden>
        <strong>首次登录请修改密码</strong>
        <p class="muted">当前使用初始密码，请在下方「修改我的密码」中设置新密码后继续。</p>
      </div>
      <div class="admin-tabs">
        <button class="button" type="button" data-admin-tab="resources">课程资源</button>
        <button class="button secondary" type="button" data-admin-tab="reviews">评价审核</button>
        <button class="button secondary" type="button" data-admin-tab="participate">参与页面</button>
        <button class="button secondary" type="button" data-admin-tab="feedback">反馈管理</button>
        <button class="button secondary" type="button" data-admin-tab="links">友链页面</button>
        <button class="button secondary" type="button" data-admin-tab="home">首页设置</button>
        <button class="button secondary" type="button" data-admin-tab="footer">页脚设置</button>
        <button class="button secondary" type="button" data-admin-tab="editor-settings">编辑器设置</button>
        <button class="button secondary" type="button" data-admin-tab="stats">访问统计</button>
        <button class="button secondary" type="button" data-admin-tab="about">关于页面</button>
        <button class="button secondary" type="button" data-admin-tab="backup">备份</button>
        <button class="button secondary" type="button" data-admin-tab="accounts">账号管理</button>
        <button class="button secondary" type="button" data-admin-tab="mp-users">小程序用户</button>
        <button class="button secondary" type="button" data-admin-tab="audit">审计日志</button>
      </div>

      <div id="resource-admin-panel">
        <div class="panel admin-toolbar">
          <div class="panel-header">
            <h2>课程资源管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="publish" type="button">保存并发布</button>
              <button class="button secondary" id="sync-r2" type="button">从 R2 同步当前课程</button>
              <button class="button secondary" id="sync-r2-all" type="button">从 R2 重建课程树</button>
              <button class="button secondary" id="add-course" type="button">新增课程</button>
              <button class="button secondary" id="download-json" type="button">下载 JSON</button>
              <button class="button secondary" id="download-backup" type="button">备份</button>
              <button class="button secondary" id="logout" type="button">退出</button>
              <span class="muted" id="publish-status"></span>
            </div>
            <div class="admin-form admin-toolbar-settings" id="manifest-settings" style="margin-top: 14px;"></div>
          </div>
        </div>

        <div class="admin-workbench">
          <aside class="panel admin-tree-panel">
            <div class="panel-header">
              <h2>课程树</h2>
              <button class="admin-icon-button" id="collapse-tree" type="button" title="收拢左侧">‹</button>
            </div>
            <div class="panel-body">
              <input class="searchbar" id="admin-search" type="search" placeholder="搜索课程" autocomplete="off" />
              <div class="admin-tree" id="admin-course-tree"></div>
            </div>
          </aside>

          <button class="admin-resizer" id="admin-resizer" type="button" title="拖动调整宽度"></button>

          <section class="panel admin-editor-panel">
            <div class="panel-header">
              <h2 id="editor-title">选择课程</h2>
            </div>
            <div class="panel-body" id="editor">
              <p class="empty">正在加载内容。</p>
            </div>
          </section>
        </div>
      </div>

      <div id="review-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>评价审核管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-reviews" type="button">保存评价设置</button>
              <button class="button secondary" id="reload-reviews" type="button">重新加载</button>
              <button class="button secondary" id="logout-reviews" type="button">退出</button>
              <span class="muted" id="review-admin-status"></span>
            </div>
              <div class="review-admin-layout">
                <details class="card admin-collapsible-card" open>
                  <summary>审核规则框架</summary>
                  <div class="admin-form" id="review-rules-editor" style="margin-top: 14px;"></div>
                </details>
                <div class="card">
                  <h3>评论内容</h3>
                  <div class="admin-moderation-grid" style="margin-top: 14px;">
                    <aside class="admin-moderation-sidebar">
                      <input class="searchbar" id="review-admin-sidebar-search" type="search" placeholder="筛选课程" autocomplete="off" />
                      <div class="admin-tree" id="review-admin-sidebar" style="margin-top: 10px;"></div>
                    </aside>
                    <div class="admin-moderation-main">
                      <div class="filter-row">
                        <input class="searchbar" id="review-admin-search" type="search" placeholder="搜索评价内容" autocomplete="off" />
                        <select class="searchbar" id="review-status-filter">
                          <option value="all">全部状态</option>
                          <option value="pending">待审</option>
                          <option value="approved">已通过</option>
                          <option value="hidden">已隐藏</option>
                          <option value="visible">显示中</option>
                        </select>
                      </div>
                      <div class="review-admin-list" id="review-admin-list" style="margin-top: 14px;"></div>
                    </div>
                  </div>
                </div>
              </div>
          </div>
        </div>
      </div>

      <div id="participate-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>参与页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-participate" type="button">保存并发布参与页</button>
              <button class="button secondary" id="reload-participate" type="button">重新加载</button>
              <span class="muted" id="participate-admin-status"></span>
            </div>
            <div class="admin-form" id="participate-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="feedback-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>反馈管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-feedback" type="button">保存反馈</button>
              <button class="button secondary" id="reload-feedback" type="button">重新加载</button>
              <span class="muted" id="feedback-admin-status"></span>
            </div>
            <details class="card admin-collapsible-card" open>
              <summary>反馈规则框架</summary>
              <div class="admin-form" id="feedback-settings-editor" style="margin-top: 14px;"></div>
              <div class="admin-form" id="feedback-rules-editor" style="margin-top: 14px;"></div>
            </details>
            <div class="card" style="margin-top: 18px;">
              <h3>反馈内容</h3>
              <input class="searchbar" id="feedback-admin-search" type="search" placeholder="搜索标题、内容或联系方式" autocomplete="off" />
              <select class="searchbar" id="feedback-status-filter">
                <option value="all">全部状态</option>
                <option value="open">待处理</option>
                <option value="completed">已完成</option>
                <option value="rejected">不予完成</option>
                <option value="parked">搁置</option>
                <option value="hidden">已隐藏</option>
              </select>
              <div class="review-admin-list" id="feedback-admin-list" style="margin-top: 14px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="links-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>友链页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-links" type="button">保存并发布友链页</button>
              <button class="button secondary" id="reload-links" type="button">重新加载</button>
              <button class="button secondary" id="add-link-item" type="button">新增链接</button>
              <span class="muted" id="links-admin-status"></span>
            </div>
            <details class="card admin-collapsible-card" open>
              <summary>页面与本站信息</summary>
              <div class="admin-form" id="links-settings-editor" style="margin-top: 14px;"></div>
            </details>
            <div class="card" style="margin-top: 18px;">
              <h3>链接内容</h3>
              <div class="review-admin-list" id="links-admin-list" style="margin-top: 14px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="stats-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>访问统计</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button secondary" id="reload-stats" type="button">重新加载</button>
              <span class="muted" id="stats-admin-status"></span>
            </div>
            <div class="backup-grid" id="stats-admin-summary" style="margin-top: 18px;"></div>
            <details class="card admin-collapsible-card" style="margin-top: 18px;" open>
              <summary>访问趋势</summary>
              <div class="filter-row" style="margin-top: 12px;">
                <button class="button secondary stats-range" data-range="7" type="button">近 7 天</button>
                <button class="button secondary stats-range" data-range="30" type="button">近 30 天</button>
                <button class="button secondary stats-range" data-range="90" type="button">近 90 天</button>
              </div>
              <div class="admin-stats-chart" id="stats-admin-chart" style="margin-top: 10px;"></div>
            </details>
            <details class="card admin-collapsible-card" style="margin-top: 18px;" open>
              <summary>按类别统计</summary>
              <div id="stats-admin-categories" style="margin-top: 14px;"></div>
            </details>
            <details class="card admin-collapsible-card" style="margin-top: 18px;">
              <summary>页面访问明细</summary>
              <div class="review-admin-list" id="stats-admin-pages" style="margin-top: 14px;"></div>
            </details>
            <details class="card admin-collapsible-card" style="margin-top: 18px;">
              <summary>最近访客（IP · 30 分钟去重）</summary>
              <div class="review-admin-list" id="stats-admin-visitors" style="margin-top: 14px;"></div>
            </details>
          </div>
        </div>
      </div>

      <div id="about-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>关于页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-about" type="button">保存并发布关于页</button>
              <button class="button secondary" id="reload-about" type="button">重新加载</button>
              <span class="muted" id="about-admin-status"></span>
            </div>
            <div class="admin-form" id="about-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="home-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>首页设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-home" type="button">保存并发布首页</button>
              <button class="button secondary" id="reload-home" type="button">重新加载</button>
              <span class="muted" id="home-admin-status"></span>
            </div>
            <div class="admin-form" id="home-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="footer-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>页脚设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-footer" type="button">保存并发布页脚</button>
              <button class="button secondary" id="reload-footer" type="button">重新加载</button>
              <span class="muted" id="footer-admin-status"></span>
            </div>
            <div class="admin-form" id="footer-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="editor-settings-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>编辑器设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-editor-settings" type="button">保存编辑器设置</button>
              <button class="button secondary" id="reload-editor-settings" type="button">重新加载</button>
              <span class="muted" id="editor-settings-admin-status"></span>
            </div>
            <div class="editor-settings-grid">
              <details class="card admin-collapsible-card" open>
                <summary>用户 Markdown 编辑器</summary>
                <div class="admin-form" id="editor-user-settings" style="margin-top: 14px;"></div>
              </details>
              <details class="card admin-collapsible-card" open>
                <summary>管理 Markdown 编辑器</summary>
                <div class="admin-form" id="editor-admin-settings" style="margin-top: 14px;"></div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <div id="accounts-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>账号管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="reload-accounts" type="button">重新加载</button>
              <span class="muted" id="accounts-admin-status"></span>
            </div>
            <details class="card admin-collapsible-card" id="create-account-card">
              <summary>新增账号</summary>
              <div class="admin-form" style="margin-top: 14px;">
                <div class="filter-row">
                  <label class="admin-field"><span>用户名</span><input id="new-account-username" type="text" autocomplete="off" placeholder="字母开头，3-32 位" /></label>
                  <label class="admin-field"><span>初始密码</span><input id="new-account-password" type="text" autocomplete="off" placeholder="至少 10 位" /></label>
                  <label class="admin-field"><span>确认初始密码</span><input id="new-account-password-confirm" type="text" autocomplete="off" placeholder="再次输入初始密码" /></label>
                </div>
                <div class="filter-row">
                  <label class="admin-field perm-role-field"><span>角色预设</span>
                    <select id="new-account-role">
                      <option value="">自定义（手动勾选）</option>
                      <option value="super_admin">super_admin（全部权限）</option>
                      <option value="content_admin">content_admin（内容编辑+审核）</option>
                      <option value="reviewer">reviewer（只读+反馈处理）</option>
                      <option value="viewer">viewer（只读）</option>
                    </select>
                  </label>
                </div>
                <div class="perm-editor-row">
                  <span class="perm-editor-label">权限点</span>
                  <div id="new-account-permissions" class="perm-editor"></div>
                </div>
                <div class="filter-row">
                  <label class="perm-check perm-check-inline"><input id="new-account-must-change" type="checkbox" checked /> 首次登录强制修改密码</label>
                  <button class="button" id="create-account" type="button">创建账号</button>
                </div>
              </div>
            </details>
            <div id="accounts-admin-list" style="margin-top: 14px;"></div>
          </div>
        </div>
        <div class="panel" style="margin-top: 14px;">
          <div class="panel-header">
            <h2>修改我的密码</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <label class="admin-field"><span>当前密码</span><input id="self-current-password" type="password" autocomplete="current-password" /></label>
              <label class="admin-field"><span>新密码</span><input id="self-new-password" type="password" autocomplete="new-password" placeholder="至少 10 位" /></label>
              <label class="admin-field"><span>确认新密码</span><input id="self-confirm-password" type="password" autocomplete="new-password" placeholder="再次输入新密码" /></label>
              <button class="button" id="change-self-password" type="button">修改密码</button>
              <span class="muted" id="self-password-status"></span>
            </div>
          </div>
        </div>
      </div>

      <div id="mp-users-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>小程序用户</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button secondary" id="reload-mp-users" type="button">重新加载</button>
              <span class="muted" id="mp-users-admin-status"></span>
            </div>
            <div class="backup-grid" id="mp-users-summary" style="margin-top: 18px;"></div>
            <div id="mp-users-list" style="margin-top: 14px;"></div>
            <p class="muted" style="margin-top: 14px;">用户身份来自微信登录（openid）。列表仅显示掩码后的 openid 标识，不记录手机号；昵称与头像为用户自行设置。</p>
          </div>
        </div>
      </div>

      <div id="audit-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>审计日志</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <label class="admin-field"><span>账号</span><input id="audit-filter-username" type="text" autocomplete="off" placeholder="按用户名筛选" /></label>
              <label class="admin-field"><span>动作</span><input id="audit-filter-action" type="text" autocomplete="off" placeholder="如 login 或 manifest" /></label>
              <button class="button secondary" id="audit-filter-apply" type="button">查询</button>
              <span class="muted" id="audit-admin-status"></span>
            </div>
            <div id="audit-admin-list" style="margin-top: 14px;"></div>
            <div class="filter-row" style="margin-top: 14px;">
              <button class="button secondary" id="audit-prev-page" type="button">上一页</button>
              <span class="muted" id="audit-page-info"></span>
              <button class="button secondary" id="audit-next-page" type="button">下一页</button>
            </div>
          </div>
        </div>
      </div>

      <div id="backup-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>备份</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-backup-settings" type="button">保存备份设置</button>
              <button class="button secondary" id="reload-backup-settings" type="button">重新加载</button>
              <button class="button secondary" id="run-backup-now" type="button">立即执行备份</button>
            </div>
            <div class="card" style="margin: 18px 0;">
              <h3>自动备份规则</h3>
              <div class="admin-form" id="backup-settings-editor" style="margin-top: 14px;"></div>
            </div>
            <div class="card" style="margin-bottom: 18px;">
              <h3>WebDAV 备份目标</h3>
              <div class="admin-form" id="webdav-settings-editor" style="margin-top: 14px;"></div>
              <button class="button secondary" id="add-webdav-destination" type="button" style="margin-top: 12px;">新增 WebDAV 目标</button>
            </div>
            <details class="card admin-collapsible-card">
              <summary>下载备份</summary>
              <div class="backup-grid" style="margin-top: 14px;">
                <article class="card">
                  <h3>整体站点数据</h3>
                  <p class="muted">包含课程树、评价、反馈、首页、关于页、参与页、友链页和安全配置摘要。</p>
                  <button class="button" type="button" data-backup-scope="all">下载整体备份</button>
                </article>
                <article class="card">
                  <h3>课程树</h3>
                  <p class="muted">只下载 manifest.json 对应的课程、板块、文件索引。</p>
                  <button class="button secondary" type="button" data-backup-scope="manifest">下载课程树</button>
                </article>
                <article class="card">
                  <h3>评价内容</h3>
                  <p class="muted">只下载评价审核规则和全部评价记录。</p>
                  <button class="button secondary" type="button" data-backup-scope="reviews">下载评价</button>
                </article>
                <article class="card">
                  <h3>反馈内容</h3>
                  <p class="muted">只下载反馈规则和全部反馈记录，包含后台可见联系方式。</p>
                  <button class="button secondary" type="button" data-backup-scope="feedback">下载反馈</button>
                </article>
                <article class="card">
                  <h3>页面内容</h3>
                  <p class="muted">只下载首页、关于页、参与页、友链页、页脚这些可编辑页面内容。</p>
                  <button class="button secondary" type="button" data-backup-scope="pages">下载页面内容</button>
                </article>
                <article class="card">
                  <h3>访问统计</h3>
                  <p class="muted">只下载访问总数、每日统计、页面统计和短期去重 IP 记录。</p>
                  <button class="button secondary" type="button" data-backup-scope="stats">下载访问统计</button>
                </article>
                <article class="card">
                  <h3>配置摘要</h3>
                  <p class="muted">只下载运行路径和 R2 配置摘要，不包含密码和密钥。</p>
                  <button class="button secondary" type="button" data-backup-scope="config">下载配置摘要</button>
                </article>
              </div>
            </details>
            <p class="muted" id="backup-admin-status" style="margin-top: 14px;"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import Vditor from "vditor";
    import { statusWithWarnings } from "../lib/admin-response-warnings.js";

    let state = null;
    let manifestRevision = "";
    let selectedId = null;
    let originalCourseHashes = new Map();
    let originalCourseBasePaths = new WeakMap();
    let originalCourseUids = new Set();
    const contentRevisions = new Map();
