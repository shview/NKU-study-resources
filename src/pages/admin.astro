          } catch (error) {
            alert(error.message);
            removeSection.textContent = "删除板块";
            removeSection.disabled = false;
            return;
          }
          course.sections.splice(sectionIndex, 1);
          renderEditor();
        });
        const removeSelected = document.createElement("button");
        removeSelected.type = "button";
        removeSelected.className = "button secondary";
        removeSelected.textContent = "删除选中文件";
        removeSelected.addEventListener("click", async () => {
          const selected = (section.files ?? []).filter((file) => selectedAdminFiles.has(file));
          if (!selected.length) {
            alert("请先勾选要删除的文件。");
            return;
          }
          if (!confirm("删除选中的 " + selected.length + " 个文件？R2 中的对象也会同步删除。")) return;
          removeSelected.textContent = "删除中...";
          removeSelected.disabled = true;
          try {
            const data = await deleteR2Paths(course, selected.map((file) => file.path));
            publishStatus.textContent = statusWithWarnings("选中文件已删除并发布", data);
          } catch (error) {
            alert(error.message);
            removeSelected.textContent = "删除选中文件";
            removeSelected.disabled = false;
            return;
          }
          section.files = (section.files ?? []).filter((file) => !selectedAdminFiles.has(file));
          selected.forEach((file) => selectedAdminFiles.delete(file));
          renderEditor();
        });
        sectionActions.append(moveUp, moveDown, removeSelected, removeSection);

        body.append(
          field("板块名", section.title, (value) => { section.title = value; renderEditor(); }),
          markdownField("板块说明（支持 Markdown）", section.note, (value) => { section.note = value; }, { height: 150 }),
          sectionActions,
          renderDropZone(course, section, sectionIndex)
        );

