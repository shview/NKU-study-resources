    async function saveEditorSettings(message = "已保存编辑器设置") {
      editorSettingsAdminStatus.textContent = "保存中...";
      const data = await api("/editor-settings", {
        method: "POST",
        body: JSON.stringify({ data: editorSettingsState }),
      });
