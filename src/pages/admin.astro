            subgroupBody.append(renderFileRow(course, file, section.files));
          }
          subgroup.append(subgroupBody);
          files.append(subgroup);
        }
        for (const file of sectionFiles.direct) {
          files.append(renderFileRow(course, file, section.files));
        }

        const addFile = document.createElement("button");
        addFile.type = "button";
        addFile.className = "button secondary";
        addFile.textContent = "手动新增文件";
        addFile.addEventListener("click", () => {
