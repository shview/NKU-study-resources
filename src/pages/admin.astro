    const DONATE_STATS_PAGE_SIZE = 50;

    async function loadDonateStats() {
      const status = document.querySelector("#donate-stats-status");
      if (status) status.textContent = "加载中...";
      try {
        const data = await api("/donate-stats");
        donateOrderSummaryCache = data.data.summary;
        donateStatsRows = data.data.recent || [];
        donateStatsPage = 1;
        renderDonateStats(donateOrderSummaryCache);
        if (status) status.textContent = "";
      } catch (error) {
        if (status) status.textContent = error.message;
      }
    }

    function donateStatsFiltered() {
      const keyword = String(document.querySelector("#donate-stats-search")?.value || "").trim().toLowerCase();
      const statusFilter = document.querySelector("#donate-stats-status")?.value || "all";
      const sourceFilter = document.querySelector("#donate-stats-source")?.value || "all";
      return donateStatsRows.filter((row) => {
        if (statusFilter !== "all" && row.status !== statusFilter) return false;
        if (sourceFilter !== "all" && (row.source || "") !== sourceFilter) return false;
        if (!keyword) return true;
        const date = new Date(Number(row.created_at) + 8 * 3600 * 1000).toISOString().slice(0, 10);
        return [row.out_trade_no, row.transaction_id, row.nickname, row.remark, String(date), String(row.amount_total / 100)]
          .map((value) => String(value || "").toLowerCase())
          .some((value) => value.includes(keyword));
      });
    }

    function renderDonateStats(summary) {
      const yuan = (fen) => (fen / 100).toFixed(2);
      const sourceLabel = { jsapi: "小程序", native: "网页扫码" };
      const s = summary || donateOrderSummaryCache;
      const filtered = donateStatsFiltered();
      const pages = Math.max(1, Math.ceil(filtered.length / DONATE_STATS_PAGE_SIZE));
      if (donateStatsPage > pages) donateStatsPage = pages;
      const slice = filtered.slice((donateStatsPage - 1) * DONATE_STATS_PAGE_SIZE, donateStatsPage * DONATE_STATS_PAGE_SIZE);
      const rows = slice.map((row) => {
        const date = new Date(Number(row.created_at) + 8 * 3600 * 1000).toISOString().slice(0, 10);
        const esc = (value) => String(value || "").replace(/[<>&"]/g, "");
        return `<tr><td>${date}</td><td>¥${yuan(row.amount_total)}</td><td>${sourceLabel[row.source] || row.source || "-"}</td><td>${esc(row.nickname) || "-"}</td><td>${esc(row.remark) || "-"}</td><td>${row.status === "paid" ? "已支付" : "待支付"}</td><td class="muted" style="font-size:12px;">${esc(row.out_trade_no)}</td></tr>`;
      }).join("");
      if (s) {
        const sources = Object.entries(s.by_source).map(([key, value]) => `${sourceLabel[key] || key} ${value.count} 笔 / ¥${yuan(value.total_fen)}`).join("，") || "暂无";
        donateStatsBody.innerHTML = `
          <p style="margin:0 0 8px;"><b>累计入账 ${s.paid_count} 笔 / ¥${yuan(s.paid_total_fen)}</b>（${sources}；待支付 ${s.pending_count} 笔）</p>
          <table class="admin-table" style="margin-top:8px;"><thead><tr><th>日期</th><th>金额</th><th>来源</th><th>昵称</th><th>备注</th><th>状态</th><th>订单号</th></tr></thead><tbody>${rows || '<tr><td colspan="7" class="muted">没有匹配的订单</td></tr>'}</tbody></table>
        `;
      }
      const pager = document.querySelector("#donate-stats-pager");
      if (pager) {
        pager.innerHTML = "";
        const prev = document.createElement("button");
        prev.type = "button";
        prev.className = "button secondary";
        prev.textContent = "上一页";
        prev.disabled = donateStatsPage <= 1;
        prev.addEventListener("click", () => { donateStatsPage -= 1; renderDonateStats(); });
        const next = document.createElement("button");
        next.type = "button";
        next.className = "button secondary";
        next.textContent = "下一页";
        next.disabled = donateStatsPage >= pages;
        next.addEventListener("click", () => { donateStatsPage += 1; renderDonateStats(); });
        const label = document.createElement("span");
        label.className = "muted";
        label.textContent = `第 ${donateStatsPage} / ${pages} 页，筛选后 ${filtered.length} 笔（共 ${donateStatsRows.length} 笔）`;
        pager.append(prev, label, next);
      }
    }

