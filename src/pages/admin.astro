    // ===== 侧边栏两级导航（P0）：分组渲染 + 无权限置灰 + 折叠/扁平记忆 =====
    const ADMIN_NAV_CONFIG = [
      { label: "内容管理", items: [
        ["resources", "课程资源"], ["reviews", "评价审核"],
        ["home", "首页设置"], ["about", "关于页面"], ["participate", "参与页面"],
        ["links", "友链页面"], ["footer", "页脚设置"], ["donate", "捐助页面"], ["privacy", "隐私与协议"],
      ] },
      { label: "用户与安全", items: [
        ["mp-users", "小程序用户"], ["accounts", "账号与权限"], ["feedback", "反馈管理"], ["reports", "举报处置"], ["audit", "审计日志"], ["law", "依法调取"],
      ] },
      { label: "系统设置", items: [
        ["service-keys", "服务密钥"], ["ai", "AI 问答"], ["notify", "通知设置"],
        ["editor-settings", "编辑器设置"], ["stats", "访问统计"], ["backup", "备份"],
      ] },
    ];
    const navCollapsedKey = "nkustudy-admin-nav-collapsed";
    const navFlatKey = "nkustudy-admin-nav-flat";

    function renderAdminNav() {
      const nav = document.querySelector("#admin-nav");
      if (!nav) return;
      nav.innerHTML = "";
      const collapsed = new Set(JSON.parse(localStorage.getItem(navCollapsedKey) || "[]"));
      const flat = localStorage.getItem(navFlatKey) === "1";
      const collapsedNow = document.querySelector("#admin-app")?.dataset.navCollapsed === "1";
      const makeItem = (tab, label) => {
        const item = document.createElement("button");
        item.type = "button";
        item.className = "admin-nav-item";
        item.dataset.adminTab = tab;
        item.textContent = label;
        return item;
      };
      const collapseToggle = document.createElement("button");
      collapseToggle.type = "button";
      collapseToggle.className = "admin-nav-collapse";
      collapseToggle.textContent = collapsedNow ? "»" : "« 收起菜单";
      collapseToggle.title = collapsedNow ? "展开菜单" : "收起菜单";
      collapseToggle.addEventListener("click", () => {
        const app = document.querySelector("#admin-app");
        const next = app?.dataset.navCollapsed === "1" ? "0" : "1";
        if (app) app.dataset.navCollapsed = next;
        localStorage.setItem("nkustudy-admin-nav-collapsed-all", next);
        collapseToggle.textContent = next === "1" ? "»" : "« 收起菜单";
        collapseToggle.title = next === "1" ? "展开菜单" : "收起菜单";
      });
      nav.append(collapseToggle);
      const scroll = document.createElement("div");
      scroll.className = "admin-nav-scroll";
      if (flat) {
        const list = document.createElement("div");
        list.className = "admin-nav-group admin-nav-group--flat";
        for (const group of ADMIN_NAV_CONFIG) {
          for (const [tab, label] of group.items) list.append(makeItem(tab, label));
        }
        scroll.append(list);
      } else {
        for (const group of ADMIN_NAV_CONFIG) {
          const groupEl = document.createElement("div");
          groupEl.className = "admin-nav-group" + (collapsed.has(group.label) ? " admin-nav-group--collapsed" : "");
          const head = document.createElement("button");
          head.type = "button";
          head.className = "admin-nav-group-head";
          head.textContent = group.label + (collapsed.has(group.label) ? " ▸" : " ▾");
          head.addEventListener("click", () => {
            const current = new Set(JSON.parse(localStorage.getItem(navCollapsedKey) || "[]"));
            if (current.has(group.label)) current.delete(group.label); else current.add(group.label);
            localStorage.setItem(navCollapsedKey, JSON.stringify([...current]));
            renderAdminNav();
          });
          groupEl.append(head);
          const items = document.createElement("div");
          items.className = "admin-nav-items";
          for (const [tab, label] of group.items) items.append(makeItem(tab, label));
          groupEl.append(items);
          scroll.append(groupEl);
        }
      }
      nav.append(scroll);
      const modeToggle = document.createElement("button");
      modeToggle.type = "button";
      modeToggle.className = "admin-nav-flat-toggle";
      modeToggle.textContent = flat ? "切换为分组" : "切换为扁平";
      modeToggle.addEventListener("click", () => {
        localStorage.setItem(navFlatKey, flat ? "0" : "1");
        renderAdminNav();
      });
      nav.append(modeToggle);
      bindAdminNavState();
      bindAdminTabButtons();
    }

    (function applyNavCollapsedMemory() {
