let aiAdminState = { loaded: false, clearKey: false };

async function loadAiAdmin() {
  const data = await api("/ai-settings");
  const settings = data.data;
  document.querySelector("#ai-enabled").value = String(settings.enabled);
  document.querySelector("#ai-api-key").value = "";
  document.querySelector("#ai-api-key").placeholder = settings.has_api_key ? `sk-…（当前：${settings.api_key_masked}${settings.seeded_from_env ? "，来自环境变量" : ""}）` : "sk-…（当前：未配置）";
  document.querySelector("#ai-base-url").value = settings.base_url;
  document.querySelector("#ai-model").value = settings.model;
  document.querySelector("#ai-max-tokens").value = settings.max_tokens;
  document.querySelector("#ai-daily-user").value = settings.daily_limit_per_user;
  document.querySelector("#ai-minute-user").value = settings.minute_limit_per_user;
  document.querySelector("#ai-daily-global").value = settings.daily_limit_global;
  aiAdminState.clearKey = false;
  aiAdminState.loaded = true;
}

async function saveAiAdmin() {
  const status = document.querySelector("#ai-status");
  status.textContent = "保存中...";
  const apiKeyInput = document.querySelector("#ai-api-key").value.trim();
  const body = {
    settings: {
      enabled: document.querySelector("#ai-enabled").value === "true",
      base_url: document.querySelector("#ai-base-url").value.trim(),
      model: document.querySelector("#ai-model").value.trim(),
      max_tokens: Number(document.querySelector("#ai-max-tokens").value),
      daily_limit_per_user: Number(document.querySelector("#ai-daily-user").value),
      minute_limit_per_user: Number(document.querySelector("#ai-minute-user").value),
      daily_limit_global: Number(document.querySelector("#ai-daily-global").value),
    },
  };
  if (apiKeyInput) body.api_key = apiKeyInput;
  if (aiAdminState.clearKey) body.clear_api_key = true;
  try {
    await api("/ai-settings", { method: "POST", body: JSON.stringify(body) });
    await loadAiAdmin();
    status.textContent = "已保存，正在自动测试连接...";
    await testAiAdmin();
  } catch (error) {
    status.textContent = error.message;
  }
}

async function testAiAdmin() {
  const status = document.querySelector("#ai-status");
  status.textContent = "测试中（最多 15 秒）...";
  const apiKeyInput = document.querySelector("#ai-api-key").value.trim();
  const body = {};
  if (apiKeyInput) body.api_key = apiKeyInput;
  if (aiAdminState.clearKey) {
    status.textContent = "已选择清除密钥，请先保存再测试。";
    return;
  }
  try {
    const data = await api("/ai-settings/test", { method: "POST", body: JSON.stringify(body) });
    const result = data.data;
    if (result.ok) status.textContent = `连接成功：模型 ${result.model}，延迟 ${result.latency_ms}ms，回复「${result.preview}」。`;
    else status.textContent = `连接失败：${result.reason}${result.error ? `（${result.error}）` : ""}`;
  } catch (error) {
    status.textContent = error.message;
  }
}

function bindAiAdminEvents() {
  document.querySelector("#ai-save").addEventListener("click", saveAiAdmin);
  document.querySelector("#ai-test").addEventListener("click", testAiAdmin);
  document.querySelector("#ai-clear-key").addEventListener("click", () => {
    aiAdminState.clearKey = !aiAdminState.clearKey;
    document.querySelector("#ai-clear-key").textContent = aiAdminState.clearKey ? "撤销清除" : "清除密钥";
    document.querySelector("#ai-status").textContent = aiAdminState.clearKey ? "保存后将清除已配置的密钥。" : "";
  });
}

async function loadServiceKeysAdmin() {
  const data = await api("/service-keys");
  serviceKeysState = { settings: data.data.settings, services: data.data.services };
