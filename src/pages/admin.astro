    function manifestWriteBodyFor(manifest, extra = {}) {
      const currentUids = new Set(manifest.courses.map((course) => course.uid).filter(Boolean));
      return {
        manifest,
        expectedRevision: manifestRevision,
        deletedCourseUids: [...originalCourseUids].filter((uid) => !currentUids.has(uid)),
        ...extra,
      };
    }

    function acceptManifest(data) {
      state = data.manifest;
      manifestRevision = data.revision;
      captureCourseHashes();
    }

    function touchChangedCourses() {
      for (const course of state.courses) {
        if (originalCourseHashes.get(course.id) !== courseHash(course)) {
          course.updated = today();
        }
      }
    }

    function sortSections(course) {
      course.sections = [...(course.sections ?? [])].sort((a, b) => {
        const rank = sectionRank(a.title) - sectionRank(b.title);
        return rank || (course.sections ?? []).indexOf(a) - (course.sections ?? []).indexOf(b);
      });
    }

