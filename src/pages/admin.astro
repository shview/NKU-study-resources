        editButton.className = "button secondary";
        editButton.textContent = "编辑";
        editButton.addEventListener("click", () => {
          document.querySelector("#notify-bot-id").value = bot.id;
          document.querySelector("#notify-bot-name").value = bot.name;
          document.querySelector("#notify-webhook").value = bot.webhookUrl;
          document.querySelector("#notify-secret").value = "";
          document.querySelector("#notify-bot-enabled").checked = bot.enabled;
          document.querySelector("#notify-purpose-moderation").checked = (bot.purposes || ["moderation"]).includes("moderation");
          document.querySelector("#notify-purpose-digest").checked = (bot.purposes || []).includes("digest");
          notifyOpsPurpose.checked = (bot.purposes || []).includes("ops");
