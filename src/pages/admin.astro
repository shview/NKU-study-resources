        const label = button.textContent;
        button.textContent = "清理中…";
        button.disabled = true;
        try {
          const data = await api("/content-images/cleanup", { method: "POST", body: JSON.stringify({ owner }) });
          button.textContent = label;
          button.disabled = false;
          const status = button.closest(".filter-row")?.querySelector(".muted");
          if (status) status.textContent = `清理完成：扫描 ${data.scanned} 张，删除 ${data.removed} 张，保留引用中 ${data.kept} 张`;
