        `;

        const editForm = document.createElement("div");
        editForm.className = "admin-form admin-inline-editor";
        editForm.append(
          selectField("类型", item.type ?? "bug", [["bug", "Bug"], ["feature", "功能改进"], ["content", "内容问题"]], (value) => {
            item.type = value;
            item.updatedAt = new Date().toISOString();
