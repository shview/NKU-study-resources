    let statsRange = 30;

    function decodePathLabel(path) {
      try {
        return decodeURIComponent(String(path));
      } catch {
        return String(path);
      }
    }

    function normalizeStatsKey(path) {
      const decoded = decodePathLabel(path).replace(/\/+$/, "") || "/";
      return decoded.toLowerCase();
    }

    function courseTitleFromStatsKey(path) {
      const decoded = decodePathLabel(path).replace(/\/+$/, "");
      const match = decoded.match(/^\/courses\/([^/]+)/);
      return match ? match[1] : "";
    }

    function pageCategory(path) {
      const key = normalizeStatsKey(path);
      if (key.startsWith("/mp/")) return "小程序";
      if (key === "/") return "首页";
      if (key === "/courses") return "课程列表";
      if (/^\/courses\/./.test(key)) return "课程详情";
      if (key === "/reviews") return "评价列表";
      if (key === "/reviews/detail") return "评价详情";
      if (key === "/about") return "关于";
      if (key === "/feedback") return "反馈";
      if (key === "/friends") return "友链";
      if (key === "/participate") return "参与贡献";
      if (key === "/__unknown__") return "未识别页面";
      return "其他";
    }

    function statsKeyLabel(path) {
      const key = normalizeStatsKey(path);
      if (/^\/courses\/./.test(key)) return `课程 · ${courseTitleFromStatsKey(path) || key}`;
      return key;
    }

    function beijingDayKeys(count) {
      const keys = [];
      const now = new Date();
      for (let offset = count - 1; offset >= 0; offset -= 1) {
        keys.push(beijingDate(new Date(now.getTime() - offset * 86_400_000)));
      }
      return keys;
    }

    function sumDays(daysMap, keys) {
      let sum = 0;
      for (const key of keys) sum += Number(daysMap?.[key] || 0);
      return sum;
    }

    function renderStatsAdmin() {
      if (!statsState) return;
      const summary = statsState.summary || {};
      const stats = statsState.stats || {};
      const todayKey = beijingDate();
      const last7 = beijingDayKeys(7);
      const last30 = beijingDayKeys(30);
      const total7 = sumDays(stats.days || {}, last7);
      const total30 = sumDays(stats.days || {}, last30);
      statsAdminSummary.innerHTML = `
        <article class="card">
          <h3>总访问量</h3>
          <p class="muted">${escapeHtml(summary.total ?? 0)} 次</p>
        </article>
        <article class="card">
          <h3>今日访问量</h3>
          <p class="muted">${escapeHtml(summary.today ?? 0)} 次</p>
        </article>
        <article class="card">
          <h3>近 7 天</h3>
          <p class="muted">${escapeHtml(total7)} 次</p>
        </article>
        <article class="card">
          <h3>近 30 天</h3>
          <p class="muted">${escapeHtml(total30)} 次</p>
        </article>
        <article class="card">
          <h3>短期去重访客</h3>
          <p class="muted">${escapeHtml(Object.keys(stats.visitors || {}).length)} 个访客记录</p>
        </article>
        <article class="card">
          <h3>更新时间</h3>
          <p class="muted">${escapeHtml(beijingDateTime(stats.updatedAt))}</p>
        </article>
      `;

      const chartKeys = beijingDayKeys(statsRange);
      const series = chartKeys.map((key) => Number(stats.days?.[key] || 0));
      const maxValue = Math.max(1, ...series);
      const width = 720;
      const height = 200;
      const paddingX = 44;
      const paddingY = 18;
      const innerW = width - paddingX - 12;
      const innerH = height - paddingY - 30;
      const points = series.map((value, index) => {
        const x = paddingX + (series.length === 1 ? innerW / 2 : (index / (series.length - 1)) * innerW);
        const y = paddingY + innerH - (value / maxValue) * innerH;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      });
      const labelIndexes = [0, Math.floor((series.length - 1) / 2), series.length - 1];
      const gridLines = [0, 0.5, 1].map((ratio) => {
        const y = paddingY + innerH - ratio * innerH;
        const label = Math.round(maxValue * ratio);
        return `<line x1="${paddingX}" y1="${y.toFixed(1)}" x2="${width - 12}" y2="${y.toFixed(1)}" stroke="var(--line)" stroke-width="1" /><text x="${paddingX - 6}" y="${(y + 4).toFixed(1)}" text-anchor="end" font-size="10" fill="currentColor">${label}</text>`;
      }).join("");
      const dateLabels = labelIndexes.map((index) => `<text x="${(paddingX + (series.length === 1 ? innerW / 2 : (index / (series.length - 1)) * innerW)).toFixed(1)}" y="${height - 8}" text-anchor="middle" font-size="10" fill="currentColor">${chartKeys[index].slice(5)}</text>`).join("");
      const pointXs = series.map((_, index) => paddingX + (series.length === 1 ? innerW / 2 : (index / (series.length - 1)) * innerW));
      statsAdminChart.innerHTML = `
        <div style="position: relative;">
          <div id="stats-chart-tooltip" style="position: absolute; display: none; pointer-events: none; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 4px 10px; font-size: 0.82rem; white-space: nowrap; z-index: 5; box-shadow: var(--shadow);"></div>
          <svg id="stats-chart-svg" viewBox="0 0 ${width} ${height}" role="img" aria-label="每日访问量折线图" style="display: block; cursor: crosshair;">
            ${gridLines}
            <line id="stats-chart-guide" x1="0" x2="0" y1="${paddingY}" y2="${paddingY + innerH}" stroke="var(--line)" stroke-width="1" stroke-dasharray="3,3" style="display: none;" />
            <polyline points="${points.join(" ")}" fill="none" stroke="currentColor" stroke-width="2" />
            ${series.map((value, index) => `<circle data-index="${index}" cx="${pointXs[index].toFixed(1)}" cy="${points[index].split(",")[1]}" r="2.5" fill="currentColor" />`).join("")}
            ${dateLabels}
          </svg>
        </div>
      `;
      const chartSvg = statsAdminChart.querySelector("#stats-chart-svg");
      const tooltip = statsAdminChart.querySelector("#stats-chart-tooltip");
      const guide = statsAdminChart.querySelector("#stats-chart-guide");
      const dots = [...statsAdminChart.querySelectorAll("circle[data-index]")];
      const highlight = (index) => {
        for (const dot of dots) dot.setAttribute("r", Number(dot.dataset.index) === index ? "5" : "2.5");
        tooltip.textContent = `${chartKeys[index]} · ${series[index]} 次访问`;
        tooltip.style.display = "block";
        guide.setAttribute("x1", pointXs[index].toFixed(1));
        guide.setAttribute("x2", pointXs[index].toFixed(1));
        guide.style.display = "";
      };
      chartSvg.addEventListener("mousemove", (event) => {
        const bounds = chartSvg.getBoundingClientRect();
        const viewBoxX = ((event.clientX - bounds.left) / bounds.width) * width;
        let nearest = 0;
        let nearestDistance = Infinity;
        for (let index = 0; index < pointXs.length; index += 1) {
          const distance = Math.abs(pointXs[index] - viewBoxX);
          if (distance < nearestDistance) {
            nearestDistance = distance;
            nearest = index;
          }
        }
        highlight(nearest);
        const chartBounds = statsAdminChart.getBoundingClientRect();
        tooltip.style.left = `${Math.max(0, Math.min(event.clientX - chartBounds.left + 14, chartBounds.width - 150))}px`;
        tooltip.style.top = `${Math.max(0, event.clientY - chartBounds.top - 36)}px`;
      });
      chartSvg.addEventListener("mouseleave", () => {
        tooltip.style.display = "none";
        guide.style.display = "none";
        for (const dot of dots) dot.setAttribute("r", "2.5");
      });

      const categories = new Map();
      const mergedPages = new Map();
      for (const [path, item] of Object.entries(stats.pages || {})) {
        const normKey = normalizeStatsKey(path);
        const merged = mergedPages.get(normKey) || {
          normKey,
          display: /^\/courses\//.test(normKey) ? statsKeyLabel(path) : normKey,
          total: 0,
          today: 0,
          days: {},
        };
        merged.total += Number(item?.total || 0);
        merged.today += Number(item?.days?.[todayKey] || 0);
        for (const [day, count] of Object.entries(item?.days || {})) {
          merged.days[day] = (merged.days[day] || 0) + Number(count || 0);
        }
        mergedPages.set(normKey, merged);

        const label = pageCategory(path);
        const entry = categories.get(label) || { label, total: 0, today: 0, last7: 0, last30: 0 };
        entry.total += Number(item?.total || 0);
        entry.today += Number(item?.days?.[todayKey] || 0);
        entry.last7 += sumDays(item?.days || {}, last7);
        entry.last30 += sumDays(item?.days || {}, last30);
        categories.set(label, entry);
      }
      const categoryRows = [...categories.values()].sort((a, b) => b.total - a.total);
      const grandTotal = categoryRows.reduce((sum, row) => sum + row.total, 0) || 1;
      if (categoryRows.length) {
        const table = document.createElement("table");
        table.className = "admin-table";
        table.innerHTML = `
          <thead><tr><th>类别</th><th>总访问</th><th>占比</th><th>今日</th><th>近 7 天</th><th>近 30 天</th></tr></thead>
          <tbody>
            ${categoryRows.map((row) => `<tr>
              <td>${escapeHtml(row.label)}</td>
              <td>${row.total}</td>
              <td>${((row.total / grandTotal) * 100).toFixed(1)}%</td>
              <td>${row.today}</td>
              <td>${row.last7}</td>
              <td>${row.last30}</td>
            </tr>`).join("")}
          </tbody>
        `;
        statsAdminCategories.innerHTML = "";
        statsAdminCategories.append(table);
      } else {
        statsAdminCategories.innerHTML = `<p class="empty">暂无页面访问记录。</p>`;
      }

      const pages = [...mergedPages.values()]
        .sort((a, b) => b.total - a.total)
        .slice(0, 30);
      statsAdminPages.innerHTML = pages.length ? "" : `<p class="empty">暂无页面访问记录。</p>`;
      for (const page of pages) {
        const item = document.createElement("article");
        item.className = "review-admin-item";
        const pageDays7 = sumDays(page.days, last7);
        item.innerHTML = `
          <strong>${escapeHtml(pageCategory(page.normKey))} · ${escapeHtml(decodePathLabel(page.display))}</strong>
          <p>总访问 ${escapeHtml(page.total)} 次 · 今日 ${escapeHtml(page.today)} 次 · 近 7 天 ${escapeHtml(pageDays7)} 次</p>
        `;
        statsAdminPages.append(item);
      }
      const visitors = Object.values(stats.visitors || {})
        .sort((a, b) => Number(b?.lastSeen || 0) - Number(a?.lastSeen || 0))
        .slice(0, 30);
      statsAdminVisitors.innerHTML = visitors.length ? "" : `<p class="empty">暂无访客记录。</p>`;
      for (const visitor of visitors) {
        const item = document.createElement("article");
        item.className = "review-admin-item";
        const time = visitor?.lastSeen ? beijingDateTime(Number(visitor.lastSeen)) : "";
        const identity = visitor?.ip || `哈希 ${String(visitor?.actorHash || "").slice(0, 12)}…` || "未知";
        item.innerHTML = `
          <strong>${escapeHtml(identity)}</strong>
          <p>最近访问 ${escapeHtml(time)}</p>
        `;
        statsAdminVisitors.append(item);
      }
    }

    function passwordField(label, configured, onInput) {
      const wrap = field(label + (configured ? "（已配置，留空不变）" : ""), "", onInput);
      wrap.querySelector("input").type = "password";
      wrap.querySelector("input").autocomplete = "new-password";
      return wrap;
    }

    function renderBackupAdmin() {
      if (!backupState) return;
      backupState.destinations ??= [];
      backupSettingsEditor.innerHTML = "";
      backupSettingsEditor.append(
        checkboxField("启用每日自动备份", backupState.autoEnabled !== false, (value) => { backupState.autoEnabled = value; }),
        field("每日执行时间（北京时间 HH:mm）", backupState.dailyTime ?? "03:20", (value) => { backupState.dailyTime = value; }),
        checkboxField("备份到独立私密 R2 存储（需维护者配置）", backupState.r2DataBackup !== false, (value) => { backupState.r2DataBackup = value; }),
        checkboxField("启用 WebDAV 备份", backupState.webdavEnabled === true, (value) => { backupState.webdavEnabled = value; }),
        checkboxField("WebDAV 同步课程文件", backupState.includeCourseFiles !== false, (value) => { backupState.includeCourseFiles = value; }),
        passwordField("备份加密口令（至少16位）", backupState.encryptionPasswordConfigured, (value) => { backupState.encryptionPassword = value; })
      );

      webdavSettingsEditor.innerHTML = "";
      if (!backupState.destinations.length) {
        const empty = document.createElement("p");
        empty.className = "empty";
        empty.textContent = "尚未添加 WebDAV 目标。";
        webdavSettingsEditor.append(empty);
