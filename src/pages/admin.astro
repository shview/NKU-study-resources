    function beijingDate(value = new Date()) {
      return new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(value);
    }

    function beijingDateTime(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      }).format(date);
    }

    async function api(path, options = {}) {
      const response = await fetch(`/admin-api${path}`, {
        ...options,
        headers: {
          "content-type": "application/json",
          "x-nkustudy-admin-request": "1",
          ...(options.headers || {}),
        },
      });
      const data = await response.json();
      if (!response.ok || data.ok === false) {
        const error = Object.assign(new Error(data.error || data.errors?.join("\n") || "请求失败"), {
          status: response.status,
          currentRevision: data.currentRevision,
        });
        if (response.status === 409) error.message += "\n服务器内容已变化，本次没有覆盖。请重新加载后再编辑。";
        throw error;
      }
      return data;
    }

    const makeId = (title) => title
      .trim()
      .toLowerCase()
      .replace(/[^\w\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, "") || `course-${Date.now()}`;

    const courseBasePath = (course) => {
      const parts = [course.term, course.group, course.title]
        .map((part) => String(part ?? "").trim())
        .filter(Boolean);
      return `${parts.join("/")}/`;
    };

    function syncCourseBasePath(course) {
      course.basePath = courseBasePath(course);
    }

    function isOpenListPlaceholder(file) {
      const text = `${file?.title ?? ""}/${file?.path ?? ""}`.toLowerCase();
      return text.includes(".openlist");
    }

    function filePathParts(section, file) {
      const parts = String(file?.path || file?.title || "").split("/").filter(Boolean);
      if (parts[0] === section.title) parts.shift();
      return parts;
    }

    function groupedSectionFiles(section) {
      const visible = (section.files ?? []).filter((file) => !isOpenListPlaceholder(file));
      const direct = [];
      const groups = new Map();
      for (const file of visible) {
        const parts = filePathParts(section, file);
        if (parts.length > 1) {
          const groupName = parts[0];
          if (!groups.has(groupName)) groups.set(groupName, []);
          groups.get(groupName).push(file);
        } else {
          direct.push(file);
        }
      }
      return {
        visible,
        direct,
        groups: Array.from(groups, ([title, files]) => ({ title, files })),
      };
    }

    const sectionRank = (title = "") => {
      const lower = title.toLowerCase();
      if (title.includes("大纲") || title.includes("说明")) return 0;
      if (title.includes("真题") || title.includes("试题") || title.includes("试卷")) return 1;
      if (lower.includes("ppt") || title.includes("课件")) return 2;
      return 3;
    };

    function today() {
      return new Date().toISOString().slice(0, 10);
    }

    function courseHash(course) {
      const copy = structuredClone(course);
      delete copy.updated;
      return JSON.stringify(copy);
    }

    function captureCourseHashes() {
      originalCourseHashes = new Map(state.courses.map((course) => [course.id, courseHash(course)]));
      originalCourseBasePaths = new WeakMap();
      state.courses.forEach((course) => originalCourseBasePaths.set(course, course.basePath));
      originalCourseUids = new Set(state.courses.map((course) => course.uid).filter(Boolean));
    }

    function manifestWriteBody(extra = {}) {
      return manifestWriteBodyFor(state, extra);
    }

    function manifestWriteBodyFor(manifest, extra = {}) {
      const currentUids = new Set(manifest.courses.map((course) => course.uid).filter(Boolean));
      return {
        manifest,
        expectedRevision: manifestRevision,
        deletedCourseUids: [...originalCourseUids].filter((uid) => !currentUids.has(uid)),
        ...extra,
      };
    }

    function acceptManifest(data) {
      state = data.manifest;
      manifestRevision = data.revision;
      captureCourseHashes();
    }

    function touchChangedCourses() {
      for (const course of state.courses) {
        if (originalCourseHashes.get(course.id) !== courseHash(course)) {
          course.updated = today();
        }
      }
    }

    function sortSections(course) {
      course.sections = [...(course.sections ?? [])].sort((a, b) => {
        const rank = sectionRank(a.title) - sectionRank(b.title);
        return rank || (course.sections ?? []).indexOf(a) - (course.sections ?? []).indexOf(b);
      });
    }

