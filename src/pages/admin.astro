      };
      donateState.records.forEach((rawRow, index) => {
        const row = ensure(rawRow);
        const line = document.createElement("div");
        line.className = "filter-row";
        line.style.marginBottom = "8px";
        const make = (value, placeholder, onInput) => {
          const input = document.createElement("input");
          input.className = "searchbar";
          input.style.minHeight = "36px";
          input.value = String(value ?? "");
          input.placeholder = placeholder;
          input.addEventListener("input", () => onInput(input.value));
          return input;
        };
        const dateInput = make(row.date, "2026-09-22", (value) => { row.date = value.slice(0, 10); });
        dateInput.style.maxWidth = "140px";
        const nickInput = make(row.nickname, "昵称（空=好心人）", (value) => { row.nickname = value.slice(0, 32); });
        nickInput.style.maxWidth = "160px";
        const usageInput = make(row.usage, "去向（初始待定）", (value) => { row.usage = value.slice(0, 40); });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "button secondary";
        del.textContent = "删除";
        del.addEventListener("click", () => {
          donateState.records.splice(index, 1);
          renderDonateRecords();
        });
        line.append(dateInput, nickInput, usageInput, del);
        donateRecordsEditor.append(line);
      });
      const add = document.createElement("button");
      add.type = "button";
      add.className = "button secondary";
      add.textContent = "添加记录";
      add.addEventListener("click", () => {
        donateState.records.push({ date: "", nickname: "", usage: "" });
        renderDonateRecords();
      });
      donateRecordsEditor.append(add);
    }

    let donateStatsRows = [];
