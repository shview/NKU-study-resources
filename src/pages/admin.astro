---
import Layout from "../layouts/Layout.astro";
import "vditor/dist/index.css";
---

<Layout title="内容管理" eyebrow="Admin">
  <section class="content admin-content">
    <div class="panel" id="login-panel">
      <div class="panel-header">
        <h2>后台登录</h2>
      </div>
      <div class="panel-body">
        <form class="admin-form" id="login-form">
          <label class="admin-field">
            <span>管理密码</span>
            <input id="admin-password" type="password" autocomplete="current-password" />
          </label>
          <div class="filter-row">
            <button class="button" type="submit">登录</button>
            <span class="muted" id="login-status"></span>
          </div>
        </form>
      </div>
    </div>

    <div id="admin-app" hidden>
      <div class="admin-tabs">
        <button class="button" type="button" data-admin-tab="resources">课程资源</button>
        <button class="button secondary" type="button" data-admin-tab="reviews">评价审核</button>
        <button class="button secondary" type="button" data-admin-tab="participate">参与页面</button>
        <button class="button secondary" type="button" data-admin-tab="feedback">反馈管理</button>
        <button class="button secondary" type="button" data-admin-tab="links">友链页面</button>
        <button class="button secondary" type="button" data-admin-tab="home">首页设置</button>
        <button class="button secondary" type="button" data-admin-tab="footer">页脚设置</button>
        <button class="button secondary" type="button" data-admin-tab="editor-settings">编辑器设置</button>
        <button class="button secondary" type="button" data-admin-tab="stats">访问统计</button>
        <button class="button secondary" type="button" data-admin-tab="about">关于页面</button>
        <button class="button secondary" type="button" data-admin-tab="backup">备份</button>
      </div>

      <div id="resource-admin-panel">
        <div class="panel admin-toolbar">
          <div class="panel-header">
            <h2>课程资源管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="publish" type="button">保存并发布</button>
              <button class="button secondary" id="sync-r2" type="button">从 R2 同步当前课程</button>
              <button class="button secondary" id="sync-r2-all" type="button">从 R2 重建课程树</button>
              <button class="button secondary" id="add-course" type="button">新增课程</button>
              <button class="button secondary" id="download-json" type="button">下载 JSON</button>
              <button class="button secondary" id="download-backup" type="button">备份</button>
              <button class="button secondary" id="logout" type="button">退出</button>
              <span class="muted" id="publish-status"></span>
            </div>
            <div class="admin-form admin-toolbar-settings" id="manifest-settings" style="margin-top: 14px;"></div>
          </div>
        </div>

        <div class="admin-workbench">
          <aside class="panel admin-tree-panel">
            <div class="panel-header">
              <h2>课程树</h2>
              <button class="admin-icon-button" id="collapse-tree" type="button" title="收拢左侧">‹</button>
            </div>
            <div class="panel-body">
              <input class="searchbar" id="admin-search" type="search" placeholder="搜索课程" autocomplete="off" />
              <div class="admin-tree" id="admin-course-tree"></div>
            </div>
          </aside>

          <button class="admin-resizer" id="admin-resizer" type="button" title="拖动调整宽度"></button>

          <section class="panel admin-editor-panel">
            <div class="panel-header">
              <h2 id="editor-title">选择课程</h2>
            </div>
            <div class="panel-body" id="editor">
              <p class="empty">正在加载内容。</p>
            </div>
          </section>
        </div>
      </div>

      <div id="review-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>评价审核管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-reviews" type="button">保存评价设置</button>
              <button class="button secondary" id="reload-reviews" type="button">重新加载</button>
              <button class="button secondary" id="logout-reviews" type="button">退出</button>
              <span class="muted" id="review-admin-status"></span>
            </div>
            <div class="review-admin-layout">
              <details class="card admin-collapsible-card" open>
                <summary>审核规则框架</summary>
                <div class="admin-form" id="review-rules-editor" style="margin-top: 14px;"></div>
              </details>
              <div class="card">
                <h3>评论内容</h3>
                <input class="searchbar" id="review-admin-search" type="search" placeholder="搜索课程或老师" autocomplete="off" style="margin-top: 14px;" />
                <select class="searchbar" id="review-status-filter" style="margin-top: 10px;">
                  <option value="all">全部状态</option>
                  <option value="pending">待审</option>
                  <option value="approved">已通过</option>
                  <option value="hidden">已隐藏</option>
                  <option value="visible">显示中</option>
                </select>
                <div class="review-admin-list" id="review-admin-list" style="margin-top: 14px;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="participate-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>参与页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-participate" type="button">保存并发布参与页</button>
              <button class="button secondary" id="reload-participate" type="button">重新加载</button>
              <span class="muted" id="participate-admin-status"></span>
            </div>
            <div class="admin-form" id="participate-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="feedback-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>反馈管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-feedback" type="button">保存反馈</button>
              <button class="button secondary" id="reload-feedback" type="button">重新加载</button>
              <span class="muted" id="feedback-admin-status"></span>
            </div>
            <details class="card admin-collapsible-card" open>
              <summary>反馈规则框架</summary>
              <div class="admin-form" id="feedback-settings-editor" style="margin-top: 14px;"></div>
              <div class="admin-form" id="feedback-rules-editor" style="margin-top: 14px;"></div>
            </details>
            <div class="card" style="margin-top: 18px;">
              <h3>反馈内容</h3>
              <input class="searchbar" id="feedback-admin-search" type="search" placeholder="搜索标题、内容或联系方式" autocomplete="off" />
              <div class="review-admin-list" id="feedback-admin-list" style="margin-top: 14px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="links-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>友链页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-links" type="button">保存并发布友链页</button>
              <button class="button secondary" id="reload-links" type="button">重新加载</button>
              <button class="button secondary" id="add-link-item" type="button">新增链接</button>
              <span class="muted" id="links-admin-status"></span>
            </div>
            <details class="card admin-collapsible-card" open>
              <summary>页面与本站信息</summary>
              <div class="admin-form" id="links-settings-editor" style="margin-top: 14px;"></div>
            </details>
            <div class="card" style="margin-top: 18px;">
              <h3>链接内容</h3>
              <div class="review-admin-list" id="links-admin-list" style="margin-top: 14px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="stats-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>访问统计</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button secondary" id="reload-stats" type="button">重新加载</button>
              <span class="muted" id="stats-admin-status"></span>
            </div>
            <div class="backup-grid" id="stats-admin-summary" style="margin-top: 18px;"></div>
            <details class="card admin-collapsible-card" style="margin-top: 18px;">
              <summary>页面访问明细</summary>
              <div class="review-admin-list" id="stats-admin-pages" style="margin-top: 14px;"></div>
            </details>
            <details class="card admin-collapsible-card" style="margin-top: 18px;">
              <summary>最近去重 IP</summary>
              <div class="review-admin-list" id="stats-admin-visitors" style="margin-top: 14px;"></div>
            </details>
          </div>
        </div>
      </div>

      <div id="about-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>关于页面管理</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-about" type="button">保存并发布关于页</button>
              <button class="button secondary" id="reload-about" type="button">重新加载</button>
              <span class="muted" id="about-admin-status"></span>
            </div>
            <div class="admin-form" id="about-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="home-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>首页设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-home" type="button">保存并发布首页</button>
              <button class="button secondary" id="reload-home" type="button">重新加载</button>
              <span class="muted" id="home-admin-status"></span>
            </div>
            <div class="admin-form" id="home-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="footer-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>页脚设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-footer" type="button">保存并发布页脚</button>
              <button class="button secondary" id="reload-footer" type="button">重新加载</button>
              <span class="muted" id="footer-admin-status"></span>
            </div>
            <div class="admin-form" id="footer-admin-editor"></div>
          </div>
        </div>
      </div>

      <div id="editor-settings-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>编辑器设置</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-editor-settings" type="button">保存编辑器设置</button>
              <button class="button secondary" id="reload-editor-settings" type="button">重新加载</button>
              <span class="muted" id="editor-settings-admin-status"></span>
            </div>
            <div class="editor-settings-grid">
              <details class="card admin-collapsible-card" open>
                <summary>用户 Markdown 编辑器</summary>
                <div class="admin-form" id="editor-user-settings" style="margin-top: 14px;"></div>
              </details>
              <details class="card admin-collapsible-card" open>
                <summary>管理 Markdown 编辑器</summary>
                <div class="admin-form" id="editor-admin-settings" style="margin-top: 14px;"></div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <div id="backup-admin-panel" hidden>
        <div class="panel">
          <div class="panel-header">
            <h2>备份</h2>
          </div>
          <div class="panel-body">
            <div class="filter-row">
              <button class="button" id="save-backup-settings" type="button">保存备份设置</button>
              <button class="button secondary" id="reload-backup-settings" type="button">重新加载</button>
              <button class="button secondary" id="run-backup-now" type="button">立即执行备份</button>
            </div>
            <div class="card" style="margin: 18px 0;">
              <h3>自动备份规则</h3>
              <div class="admin-form" id="backup-settings-editor" style="margin-top: 14px;"></div>
            </div>
            <div class="card" style="margin-bottom: 18px;">
              <h3>WebDAV 备份目标</h3>
              <div class="admin-form" id="webdav-settings-editor" style="margin-top: 14px;"></div>
              <button class="button secondary" id="add-webdav-destination" type="button" style="margin-top: 12px;">新增 WebDAV 目标</button>
            </div>
            <details class="card admin-collapsible-card">
              <summary>下载备份</summary>
              <div class="backup-grid" style="margin-top: 14px;">
                <article class="card">
                  <h3>整体站点数据</h3>
                  <p class="muted">包含课程树、评价、反馈、首页、关于页、参与页、友链页和安全配置摘要。</p>
                  <button class="button" type="button" data-backup-scope="all">下载整体备份</button>
                </article>
                <article class="card">
                  <h3>课程树</h3>
                  <p class="muted">只下载 manifest.json 对应的课程、板块、文件索引。</p>
                  <button class="button secondary" type="button" data-backup-scope="manifest">下载课程树</button>
                </article>
                <article class="card">
                  <h3>评价内容</h3>
                  <p class="muted">只下载评价审核规则和全部评价记录。</p>
                  <button class="button secondary" type="button" data-backup-scope="reviews">下载评价</button>
                </article>
                <article class="card">
                  <h3>反馈内容</h3>
                  <p class="muted">只下载反馈规则和全部反馈记录，包含后台可见联系方式。</p>
                  <button class="button secondary" type="button" data-backup-scope="feedback">下载反馈</button>
                </article>
                <article class="card">
                  <h3>页面内容</h3>
                  <p class="muted">只下载首页、关于页、参与页、友链页、页脚这些可编辑页面内容。</p>
                  <button class="button secondary" type="button" data-backup-scope="pages">下载页面内容</button>
                </article>
                <article class="card">
                  <h3>访问统计</h3>
                  <p class="muted">只下载访问总数、每日统计、页面统计和短期去重 IP 记录。</p>
                  <button class="button secondary" type="button" data-backup-scope="stats">下载访问统计</button>
                </article>
                <article class="card">
                  <h3>配置摘要</h3>
                  <p class="muted">只下载运行路径和 R2 配置摘要，不包含密码和密钥。</p>
                  <button class="button secondary" type="button" data-backup-scope="config">下载配置摘要</button>
                </article>
              </div>
            </details>
            <p class="muted" id="backup-admin-status" style="margin-top: 14px;"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import Vditor from "vditor";
    import { statusWithWarnings } from "../lib/admin-response-warnings.js";

    let state = null;
    let manifestRevision = "";
    let selectedId = null;
    let originalCourseHashes = new Map();
    let originalCourseBasePaths = new WeakMap();
    let originalCourseUids = new Set();
    const contentRevisions = new Map();
    let reviewState = null;
    let reviewRevision = "";
    let feedbackState = null;
    let aboutState = null;
    let homeState = null;
    let footerState = null;
    let statsState = null;
    let participateState = null;
    let linksState = null;
    let backupState = null;
    let editorSettingsState = null;
    const adminPageSize = 10;
    let reviewAdminPage = 1;
    let feedbackAdminPage = 1;
    const selectedAdminFiles = new WeakSet();

    const loginPanel = document.querySelector("#login-panel");
    const loginForm = document.querySelector("#login-form");
    const loginStatus = document.querySelector("#login-status");
    const adminApp = document.querySelector("#admin-app");
    const workbench = document.querySelector(".admin-workbench");
    const collapseTreeButton = document.querySelector("#collapse-tree");
    const resizer = document.querySelector("#admin-resizer");
    const treeEl = document.querySelector("#admin-course-tree");
    const editorEl = document.querySelector("#editor");
    const editorTitle = document.querySelector("#editor-title");
    const searchEl = document.querySelector("#admin-search");
    const publishStatus = document.querySelector("#publish-status");
    const manifestSettings = document.querySelector("#manifest-settings");
    const resourceAdminPanel = document.querySelector("#resource-admin-panel");
    const reviewAdminPanel = document.querySelector("#review-admin-panel");
    const reviewRulesEditor = document.querySelector("#review-rules-editor");
    const reviewAdminList = document.querySelector("#review-admin-list");
    const reviewAdminSearch = document.querySelector("#review-admin-search");
    const reviewStatusFilter = document.querySelector("#review-status-filter");
    const reviewAdminStatus = document.querySelector("#review-admin-status");
    const feedbackAdminPanel = document.querySelector("#feedback-admin-panel");
    const feedbackAdminList = document.querySelector("#feedback-admin-list");
    const feedbackAdminSearch = document.querySelector("#feedback-admin-search");
    const feedbackSettingsEditor = document.querySelector("#feedback-settings-editor");
    const feedbackRulesEditor = document.querySelector("#feedback-rules-editor");
    const feedbackAdminStatus = document.querySelector("#feedback-admin-status");
    const linksAdminPanel = document.querySelector("#links-admin-panel");
    const linksSettingsEditor = document.querySelector("#links-settings-editor");
    const linksAdminList = document.querySelector("#links-admin-list");
    const linksAdminStatus = document.querySelector("#links-admin-status");
    const participateAdminPanel = document.querySelector("#participate-admin-panel");
    const participateAdminEditor = document.querySelector("#participate-admin-editor");
    const participateAdminStatus = document.querySelector("#participate-admin-status");
    const aboutAdminPanel = document.querySelector("#about-admin-panel");
    const aboutAdminEditor = document.querySelector("#about-admin-editor");
    const aboutAdminStatus = document.querySelector("#about-admin-status");
    const homeAdminPanel = document.querySelector("#home-admin-panel");
    const homeAdminEditor = document.querySelector("#home-admin-editor");
    const homeAdminStatus = document.querySelector("#home-admin-status");
    const footerAdminPanel = document.querySelector("#footer-admin-panel");
    const footerAdminEditor = document.querySelector("#footer-admin-editor");
    const footerAdminStatus = document.querySelector("#footer-admin-status");
    const editorSettingsAdminPanel = document.querySelector("#editor-settings-admin-panel");
    const editorSettingsAdminStatus = document.querySelector("#editor-settings-admin-status");
    const editorUserSettings = document.querySelector("#editor-user-settings");
    const editorAdminSettings = document.querySelector("#editor-admin-settings");
    const statsAdminPanel = document.querySelector("#stats-admin-panel");
    const statsAdminSummary = document.querySelector("#stats-admin-summary");
    const statsAdminPages = document.querySelector("#stats-admin-pages");
    const statsAdminVisitors = document.querySelector("#stats-admin-visitors");
    const statsAdminStatus = document.querySelector("#stats-admin-status");
    const backupAdminPanel = document.querySelector("#backup-admin-panel");
    const backupAdminStatus = document.querySelector("#backup-admin-status");
    const backupSettingsEditor = document.querySelector("#backup-settings-editor");
    const webdavSettingsEditor = document.querySelector("#webdav-settings-editor");
    const toolbarOptions = [
      ["headings", "标题"],
      ["bold", "加粗"],
      ["italic", "斜体"],
      ["strike", "删除线"],
      ["line", "分割线"],
      ["quote", "引用"],
      ["list", "无序列表"],
      ["ordered-list", "有序列表"],
      ["check", "任务列表"],
      ["outdent", "减少缩进"],
      ["indent", "增加缩进"],
      ["code", "代码块"],
      ["inline-code", "行内代码"],
      ["insert-after", "后插入"],
      ["insert-before", "前插入"],
      ["undo", "撤销"],
      ["redo", "重做"],
      ["upload", "上传（预留）"],
      ["link", "链接"],
      ["table", "表格"],
      ["record", "录音"],
      ["edit-mode", "编辑模式"],
      ["both", "双栏模式"],
      ["preview", "预览"],
      ["fullscreen", "全屏"],
      ["outline", "大纲"],
      ["code-theme", "代码主题"],
      ["content-theme", "内容主题"],
      ["export", "导出"],
      ["devtools", "调试"],
      ["info", "信息"],
      ["help", "帮助"],
      ["br", "换行"],
    ];
    const defaultUserToolbar = ["bold", "italic", "strike", "headings", "link", "list", "ordered-list", "check", "quote", "code", "line", "table", "preview", "fullscreen"];
    const defaultAdminToolbar = ["bold", "italic", "strike", "headings", "link", "list", "ordered-list", "check", "quote", "code", "line", "table", "preview", "fullscreen", "outline"];

    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    function beijingDate(value = new Date()) {
      return new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(value);
    }

    function beijingDateTime(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      }).format(date);
    }

    async function api(path, options = {}) {
      const response = await fetch(`/admin-api${path}`, {
        ...options,
        headers: {
          "content-type": "application/json",
          ...(options.headers || {}),
        },
      });
      const data = await response.json();
      if (!response.ok || data.ok === false) {
        const error = Object.assign(new Error(data.error || data.errors?.join("\n") || "请求失败"), {
          status: response.status,
          currentRevision: data.currentRevision,
        });
        if (response.status === 409) error.message += "\n服务器内容已变化，本次没有覆盖。请重新加载后再编辑。";
        throw error;
      }
      return data;
    }

    const makeId = (title) => title
      .trim()
      .toLowerCase()
      .replace(/[^\w\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, "") || `course-${Date.now()}`;

    const courseBasePath = (course) => {
      const parts = [course.term, course.group, course.title]
        .map((part) => String(part ?? "").trim())
        .filter(Boolean);
      return `${parts.join("/")}/`;
    };

    function syncCourseBasePath(course) {
      course.basePath = courseBasePath(course);
    }

    function isOpenListPlaceholder(file) {
      const text = `${file?.title ?? ""}/${file?.path ?? ""}`.toLowerCase();
      return text.includes(".openlist");
    }

    function filePathParts(section, file) {
      const parts = String(file?.path || file?.title || "").split("/").filter(Boolean);
      if (parts[0] === section.title) parts.shift();
      return parts;
    }

    function groupedSectionFiles(section) {
      const visible = (section.files ?? []).filter((file) => !isOpenListPlaceholder(file));
      const direct = [];
      const groups = new Map();
      for (const file of visible) {
        const parts = filePathParts(section, file);
        if (parts.length > 1) {
          const groupName = parts[0];
          if (!groups.has(groupName)) groups.set(groupName, []);
          groups.get(groupName).push(file);
        } else {
          direct.push(file);
        }
      }
      return {
        visible,
        direct,
        groups: Array.from(groups, ([title, files]) => ({ title, files })),
      };
    }

    const sectionRank = (title = "") => {
      const lower = title.toLowerCase();
      if (title.includes("大纲") || title.includes("说明")) return 0;
      if (title.includes("真题") || title.includes("试题") || title.includes("试卷")) return 1;
      if (lower.includes("ppt") || title.includes("课件")) return 2;
      return 3;
    };

    function today() {
      return new Date().toISOString().slice(0, 10);
    }

    function courseHash(course) {
      const copy = structuredClone(course);
      delete copy.updated;
      return JSON.stringify(copy);
    }

    function captureCourseHashes() {
      originalCourseHashes = new Map(state.courses.map((course) => [course.id, courseHash(course)]));
      originalCourseBasePaths = new WeakMap();
      state.courses.forEach((course) => originalCourseBasePaths.set(course, course.basePath));
      originalCourseUids = new Set(state.courses.map((course) => course.uid).filter(Boolean));
    }

    function manifestWriteBody(extra = {}) {
      return manifestWriteBodyFor(state, extra);
    }

    function manifestWriteBodyFor(manifest, extra = {}) {
      const currentUids = new Set(manifest.courses.map((course) => course.uid).filter(Boolean));
      return {
        manifest,
        expectedRevision: manifestRevision,
        deletedCourseUids: [...originalCourseUids].filter((uid) => !currentUids.has(uid)),
        ...extra,
      };
    }

    function acceptManifest(data) {
      state = data.manifest;
      manifestRevision = data.revision;
      captureCourseHashes();
    }

    function touchChangedCourses() {
      for (const course of state.courses) {
        if (originalCourseHashes.get(course.id) !== courseHash(course)) {
          course.updated = today();
        }
      }
    }

    function sortSections(course) {
      course.sections = [...(course.sections ?? [])].sort((a, b) => {
        const rank = sectionRank(a.title) - sectionRank(b.title);
        return rank || (course.sections ?? []).indexOf(a) - (course.sections ?? []).indexOf(b);
      });
    }

