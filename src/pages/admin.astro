        details.innerHTML = "<summary>" + escapeHtml(section.title || "未命名板块") + ' <span class="muted">(' + sectionFiles.visible.length + ")</span></summary>";

        const body = document.createElement("div");
        body.className = "admin-section-body";
        const sectionActions = document.createElement("div");
        sectionActions.className = "filter-row";
        const moveUp = document.createElement("button");
        moveUp.type = "button";
        moveUp.className = "button secondary";
        moveUp.textContent = "上移";
        moveUp.disabled = sectionIndex === 0;
        moveUp.addEventListener("click", () => {
          if (sectionIndex <= 0) return;
          const list = course.sections;
          [list[sectionIndex - 1], list[sectionIndex]] = [list[sectionIndex], list[sectionIndex - 1]];
          renderEditor();
        });
        const moveDown = document.createElement("button");
        moveDown.type = "button";
        moveDown.className = "button secondary";
        moveDown.textContent = "下移";
        moveDown.disabled = sectionIndex === course.sections.length - 1;
        moveDown.addEventListener("click", () => {
          if (sectionIndex >= course.sections.length - 1) return;
          const list = course.sections;
          [list[sectionIndex + 1], list[sectionIndex]] = [list[sectionIndex], list[sectionIndex + 1]];
          renderEditor();
        });
        const removeSection = document.createElement("button");
        removeSection.type = "button";
        removeSection.className = "button secondary";
        removeSection.textContent = "删除板块";
