    async function runLawQuery({ exportJson = false } = {}) {
      const status = document.querySelector("#law-admin-status");
      const type = document.querySelector("#law-query-type").value;
      const value = document.querySelector("#law-query-value").value.trim();
      if (!value) { status.textContent = "请输入查询值"; return; }
      status.textContent = "查询中...";
      try {
        const param = type === "account" ? "value" : "id";
        const url = `${exportJson ? "/law-export" : "/law-query"}?type=${encodeURIComponent(type)}&${param}=${encodeURIComponent(value)}`;
        if (exportJson) {
          status.textContent = "";
          window.location.href = url;
          await new Promise((r) => setTimeout(r, 800));
          await loadLawLogs();
          return;
        }
        const response = await fetch(url, { headers: { "x-nkustudy-admin-request": "1" } });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || "查询失败");
        lawResultData = data.data;
        renderLawResult();
        renderLawLogs(data.law_logs || []);
        status.textContent = "";
      } catch (error) {
        status.textContent = error.message;
      }
    }

