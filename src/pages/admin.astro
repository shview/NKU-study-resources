    async function deleteR2Paths(course, paths) {
      const cleanPaths = paths.filter(Boolean);
      if (!cleanPaths.length) return {};
      const candidate = structuredClone(state);
      const target = candidate.courses.find((item) => item.uid === course.uid);
      const deleting = new Set(cleanPaths);
      for (const section of target?.sections || []) {
        section.files = (section.files || []).filter((file) => !deleting.has(file.path));
      }
      const data = await api("/r2-publish", {
        method: "POST",
        body: JSON.stringify(manifestWriteBodyFor(candidate, {
          fileDeletes: [{ courseUid: course.uid, paths: cleanPaths }],
          moves: changedCourseDirectories(),
        })),
      });
      acceptManifest(data);
      return data;
    }

    async function deleteCourse(course) {
      if (!confirm("删除课程「" + (course.title || "") + "」？课程记录、资源板块和 R2 中 " + (course.basePath || "") + " 下的文件都会删除。")) return;
      publishStatus.textContent = "正在删除课程...";
      const candidate = structuredClone(state);
      candidate.courses = candidate.courses.filter((item) => item.uid !== course.uid);
      const data = await api("/r2-publish", {
        method: "POST",
        body: JSON.stringify(manifestWriteBodyFor(candidate, {
          moves: changedCourseDirectories().filter((move) => move.courseUid !== course.uid),
        })),
      });
      acceptManifest(data);
      selectedId = state.courses[0]?.id ?? null;
      renderTree();
      renderEditor();
      publishStatus.textContent = statusWithWarnings("课程已删除并发布", data);
    }

    function changedCourseDirectories() {
      const moves = [];
      for (const course of state.courses) {
        const oldBasePath = originalCourseBasePaths.get(course);
        if (!oldBasePath || oldBasePath === course.basePath) continue;
        moves.push({ courseUid: course.uid, oldBasePath, newBasePath: course.basePath });
      }
      return moves;
    }

    function renderFileRow(course, file, files) {
      const wrap = document.createElement("div");
      wrap.className = "admin-file-item";
      const row = document.createElement("div");
      row.className = "admin-file-row compact";
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "admin-file-check";
      checkbox.checked = selectedAdminFiles.has(file);
      checkbox.title = "选择文件";
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) selectedAdminFiles.add(file);
        else selectedAdminFiles.delete(file);
      });

      const name = document.createElement("input");
      name.value = file.title ?? "";
      name.placeholder = "文件名";
      name.addEventListener("input", () => { file.title = name.value; });

      const size = document.createElement("span");
      size.className = "pill";
      size.textContent = String(Math.max(0, Number(file.size ?? 0))) + " B";

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "button secondary";
      remove.textContent = "删除";
      remove.addEventListener("click", async () => {
        if (!confirm("删除文件「" + (file.title || "") + "」？R2 中的对象也会同步删除。")) return;
        remove.textContent = "删除中...";
        remove.disabled = true;
        try {
          const data = await deleteR2Paths(course, [file.path]);
          publishStatus.textContent = statusWithWarnings("文件已删除并发布", data);
        } catch (error) {
          alert(error.message);
          remove.textContent = "删除";
          remove.disabled = false;
          return;
        }
        const index = files.indexOf(file);
        if (index >= 0) files.splice(index, 1);
        renderEditor();
      });

      row.append(checkbox, name, size, remove);

      const description = document.createElement("details");
      description.className = "admin-file-description";
      description.open = false;
      description.innerHTML = `<summary>说明（支持 Markdown）</summary>`;
      description.append(
        field("资源说明", file.description ?? "", (value) => {
          file.description = value;
          file.updatedAt = new Date().toISOString();
        }, true)
      );

      wrap.append(row, description);
      return wrap;
    }

    function filesFromEntry(entry, prefix = "") {
      return new Promise((resolve) => {
        if (entry.isFile) {
          entry.file((file) => {
            Object.defineProperty(file, "relativePath", { value: String(prefix) + file.name });
            resolve([file]);
          });
          return;
        }

        const reader = entry.createReader();
        const entries = [];
        const read = () => {
          reader.readEntries(async (batch) => {
            if (!batch.length) {
              const nested = await Promise.all(entries.map((item) => filesFromEntry(item, String(prefix) + entry.name + "/")));
              resolve(nested.flat());
              return;
            }
            entries.push(...batch);
            read();
          });
        };
        read();
      });
    }

    async function droppedFiles(event) {
      const items = Array.from(event.dataTransfer.items ?? []);
      if (items.length && items[0].webkitGetAsEntry) {
        const nested = await Promise.all(items.map((item) => {
          const entry = item.webkitGetAsEntry();
          return entry ? filesFromEntry(entry) : [];
        }));
        return nested.flat();
      }
      return Array.from(event.dataTransfer.files ?? []).map((file) => {
        Object.defineProperty(file, "relativePath", { value: file.webkitRelativePath || file.name });
        return file;
      });
    }

    async function uploadFiles(course, section, sectionIndex, files, progressBar, progressText) {
      touchChangedCourses();
      const draft = await api("/manifest-draft", {
        method: "POST",
        body: JSON.stringify(manifestWriteBody()),
      });
      acceptManifest(draft);
      course = state.courses.find((item) => item.id === course.id) || course;
      section = course.sections?.[sectionIndex];
      if (!section) throw new Error("课程板块在保存草稿后发生变化，请重新选择后上传。");

      const form = new FormData();
      for (const file of files) {
        form.append("files", file, file.relativePath || file.webkitRelativePath || file.name);
      }

      const data = await new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/admin-api/upload?courseId=" + encodeURIComponent(course.id) + "&sectionIndex=" + sectionIndex);
        xhr.upload.addEventListener("progress", (event) => {
          if (!event.lengthComputable) return;
          const percent = Math.round((event.loaded / event.total) * 100);
          progressBar.value = percent;
          progressText.textContent = String(percent) + "%";
        });
        xhr.addEventListener("load", () => {
          try {
            const json = JSON.parse(xhr.responseText || "{}");
            if (xhr.status < 200 || xhr.status >= 300 || json.ok === false) {
              reject(new Error(json.error || "上传失败"));
            } else {
              resolve(json);
            }
          } catch {
            reject(new Error("上传响应格式错误"));
          }
        });
        xhr.addEventListener("error", () => reject(new Error("上传失败")));
        xhr.send(form);
      });

      section.files ??= [];
      section.files.push(...data.files);
      renderEditor();
    }

    function renderDropZone(course, section, sectionIndex) {
      const drop = document.createElement("div");
      drop.className = "admin-dropzone";
      const label = document.createElement("span");
      label.textContent = "拖拽文件或文件夹到这里上传";
      const progress = document.createElement("progress");
      progress.max = 100;
      progress.value = 0;
      progress.hidden = true;
      const progressText = document.createElement("span");
      progressText.className = "muted";
      progressText.hidden = true;
      drop.append(label, progress, progressText);

      drop.addEventListener("dragover", (event) => {
        event.preventDefault();
        drop.dataset.dragging = "true";
      });
      drop.addEventListener("dragleave", () => {
        drop.dataset.dragging = "false";
      });
      drop.addEventListener("drop", async (event) => {
        event.preventDefault();
        drop.dataset.dragging = "false";
        label.textContent = "上传中...";
        progress.value = 0;
        progress.hidden = false;
        progressText.hidden = false;
        progressText.textContent = "0%";
        try {
          const files = await droppedFiles(event);
          await uploadFiles(course, section, sectionIndex, files, progress, progressText);
        } catch (error) {
          label.textContent = error.message;
          progress.hidden = true;
          progressText.hidden = true;
        }
      });

      return drop;
    }

