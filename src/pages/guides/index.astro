---
import Layout from '../../layouts/Layout.astro';
import snapshot from '../../../server/data/learning-compass-snapshot.json';
import documents from '../../../content/guide-documents.json';
const topics=[['freshman','启','新生入学','从第一次选课到适应校园'],['study','学','学海无涯','选课、成绩与学业规划'],['life','居','在校生活','校园生活、规则与权益'],['senior','诀','学长焚决','学习、科研与升学经验']];
const items=[...snapshot.guides.map(g=>({id:g.id,title:g.title,summary:g.summary,url:`/guides/${g.id}/`,kind:g.content_type==='student_experience'?'experience':'guide',category:g.category})),...documents.map(d=>({id:d.id,title:d.title,summary:d.description,url:d.file_url,kind:'pdf',category:''}))].map(i=>{const text=i.title+' '+i.summary;const t=new Set<string>();if(i.kind!=='guide')t.add('senior');else t.add(i.category==='rules-rights'?'life':'study');if(/新生|报到|注册|选课/.test(text))t.add('freshman');if(/选课|课程|考试|成绩|专业|辅修|科研|升学|保研|考研|竞赛|AI|学习/i.test(text))t.add('study');if(/宿舍|住宿|食堂|校园|生活|权益|申诉|纪律|健康/.test(text))t.add('life');return {...i,topics:[...t]};});
---
<Layout title="学习指南针" eyebrow="NKUSTUDY · 校园指南">
<div class="guides-content">
 <section class="guide-hero"><div><p class="eyebrow">从新生入学到校园生活</p><h2>找到下一步方向</h2><p>学生共建 · 重要事项以最新官方文件为准</p></div><span class="hero-mark" aria-hidden="true">指南</span></section>
 <section class="guide-tools" aria-label="查找指南">
 <label for="guide-query">搜索指南与学生资料</label><input id="guide-query" type="search" maxlength="80" placeholder="选课、保研、软件学院…" />
 <div class="topic-grid">{topics.map(([id,symbol,title,desc])=><button class="topic" data-topic={id} aria-pressed="false"><span>{symbol}</span><strong>{title}</strong><small>{desc}</small></button>)}</div>
 <div class="guide-filters"><button id="all-topics" class="selected" aria-pressed="true">全部分类</button><label>内容类型 <select id="guide-kind"><option value="">全部内容</option><option value="guide">学校文件</option><option value="experience">生存手册</option><option value="pdf">学生经验 PDF</option></select></label></div>
 </section>
 <p id="guide-count" role="status">共 {items.length} 项内容</p>
 <div class="guide-list">{items.map(i=><a class="guide-row" href={i.url} data-topics={i.topics.join(' ')} data-kind={i.kind} data-search={(i.title+' '+i.summary).toLowerCase()} target={i.kind==='pdf'?'_blank':undefined} rel={i.kind==='pdf'?'noopener':undefined}><span class="guide-badge">{i.kind==='pdf'?'PDF':i.kind==='experience'?'经验':'指南'}</span><div><h2>{i.title}</h2><p>{i.summary}</p><small>{i.kind==='guide'?'学校文件 · 指南':i.kind==='pdf'?'学生共建 · PDF':'学生经验 · 飞书生存手册'}</small></div><span aria-hidden="true">›</span></a>)}</div>
 <div id="guide-empty" class="panel" hidden>没有找到匹配内容，请换个关键词或选择全部分类。</div>
 <p class="guide-note">搜索范围为标题与摘要。学生经验不代表学校规定；原作者署名及来源保留在详情页。</p>
</div>
</Layout>
<script>
 let topic='';const query=document.querySelector<HTMLInputElement>('#guide-query')!;const kind=document.querySelector<HTMLSelectElement>('#guide-kind')!;
 const synonyms=[['保研','推免'],['转专业','专业分流'],['挂科','补考','重修'],['人工智能','ai']];
 function filter(){const terms=query.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;document.querySelectorAll<HTMLElement>('.guide-row').forEach(row=>{const text=row.dataset.search||'';const matched=terms.every(t=>(synonyms.find(s=>s.includes(t))||[t]).some(w=>text.includes(w)));row.hidden=!(matched&&(!topic||(row.dataset.topics||'').split(' ').includes(topic))&&(!kind.value||kind.value===row.dataset.kind));if(!row.hidden)count++;});document.querySelector('#guide-count')!.textContent=`找到 ${count} 项内容`;document.querySelector<HTMLElement>('#guide-empty')!.hidden=count>0;document.querySelectorAll<HTMLElement>('[data-topic]').forEach(b=>{const active=b.dataset.topic===topic;b.setAttribute('aria-pressed',String(active));b.classList.toggle('selected',active)});document.querySelector('#all-topics')!.setAttribute('aria-pressed',String(!topic));document.querySelector('#all-topics')!.classList.toggle('selected',!topic);}
 document.querySelectorAll<HTMLElement>('[data-topic]').forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.topic||'';filter()}));document.querySelector('#all-topics')!.addEventListener('click',()=>{topic='';filter()});query.addEventListener('input',filter);kind.addEventListener('change',filter);
</script>
<style>.guides-content{padding:24px}@media(max-width:700px){.guides-content{padding:16px}}
.guide-hero{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:30px;background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--radius);margin-bottom:22px}.guide-hero h2{font-size:30px;margin:8px 0;text-wrap:balance}.guide-hero p{color:var(--muted)}.hero-mark{font-size:30px;color:var(--primary);padding:20px;border:1px solid var(--line-soft);border-radius:50%}.guide-tools{display:grid;gap:14px}.guide-tools>label{font-weight:600}.guide-tools>input{width:100%;font:inherit;padding:16px;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:var(--radius)}.topic-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.topic{display:grid;gap:9px;text-align:left;background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--radius);padding:20px;color:var(--text);cursor:pointer}.topic span{color:var(--primary);font-size:24px}.topic strong{font-size:17px}.topic small{color:var(--muted);line-height:1.6}.topic.selected{border-color:var(--primary)}.guide-filters{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.guide-filters button,.guide-filters select{font:inherit;padding:9px 13px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--text)}.guide-filters .selected{color:var(--primary);border-color:var(--primary)}#guide-count,.guide-note{font-size:14px;color:var(--muted)}.guide-list{display:grid;gap:12px}.guide-row{display:flex;align-items:center;gap:20px;background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--radius);padding:24px}.guide-row:hover{border-color:var(--primary)}.guide-row>div{flex:1;min-width:0}.guide-row h2{font-size:18px;margin:0 0 8px}.guide-row p{font-size:14px;line-height:1.7;color:var(--muted);margin:0 0 10px}.guide-row small{color:var(--muted)}.guide-badge{color:var(--primary);background:var(--surface-soft);padding:12px;border-radius:8px;font-size:13px}.guide-note{line-height:1.8;margin-top:24px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--primary);outline-offset:3px}@media(max-width:700px){.topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-hero{padding:20px}.hero-mark{display:none}.guide-hero h2{font-size:24px}.guide-row{padding:16px;gap:12px}.topic{padding:15px}}
</style>
