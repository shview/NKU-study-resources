---
import Layout from "../layouts/Layout.astro";
import { readBuildData } from "../lib/runtime-data";
import { markdownToHtml } from "../lib/markdown";
import "vditor/dist/index.css";
const feedbackData = readBuildData("feedback.json");
---

<Layout title="反馈" eyebrow="Feedback">
  <section class="content feedback-page">
    <div class="panel">
      <div class="panel-header review-head">
        <h2 id="feedback-title">{feedbackData.title ?? "问题与建议"}</h2>
        <div class="header-actions">
          <a class="button secondary" href="/report/">私密投诉举报</a>
          <button class="button" id="open-feedback-form" type="button">提交反馈</button>
        </div>
      </div>
      <div class="panel-body">
        <p class="muted">这里展示已获准公开的问题与建议。投诉举报请使用<a href="/report/">可匿名的私密入口</a>。</p>
        <div
          class="review-announcement markdown-body"
          id="feedback-announcement"
          hidden={!feedbackData.announcement}
          set:html={markdownToHtml(feedbackData.announcement ?? "")}
        />
        <div class="filter-row" style="margin-bottom: 14px; align-items: center; gap: 10px;">
          <input class="searchbar" id="feedback-search" type="text" placeholder="搜索反馈标题、内容或管理员回复" style="flex: 1; min-width: 0;" />
          <span class="muted" id="feedback-search-clear" hidden style="cursor: pointer;">清除</span>
        </div>
        <div class="filter-row" id="feedback-status-filter" style="margin-bottom: 14px; flex-wrap: wrap; gap: 8px;"></div>
        <div class="review-list" id="feedback-list">
          <p class="empty">正在加载反馈。</p>
        </div>
        <div class="pagination" id="feedback-pagination" hidden></div>
      </div>
    </div>

    <div class="panel" id="feedback-submit-panel" hidden style="margin-top: 20px;">
      <div class="panel-header">
        <h2>提交反馈</h2>
      </div>
      <div class="panel-body">
        <p class="field-hint">普通反馈需登录、手机号已认证且账号未封禁；提交后由管理员审核公开。认证需要微信小程序手机号授权。<button class="feedback-login-link" id="feedback-open-login" type="button">登录 / 注册</button>，或<a href="/me/">查看账号状态</a>。投诉举报可<a href="/report/">直接私密提交</a>。</p>
        <form class="review-form" id="feedback-form">
          <label class="admin-field">
            <span>类型</span>
            <select name="type">
              <option value="bug">Bug</option>
              <option value="feature">功能改进</option>
              <option value="content">内容问题</option>
            </select>
          </label>
          <label class="admin-field">
            <span>标题</span>
            <input name="title" maxlength="120" placeholder="简短说明问题或建议" autocomplete="off" required />
            <small class="field-hint">建议 5-40 字，便于管理员快速判断。</small>
          </label>
          <div class="admin-field">
            <span>内容</span>
            <div id="feedback-basic-panel">
              <textarea id="feedback-basic-content" aria-label="反馈内容" maxlength="2000" rows="7" placeholder="请描述出现位置、复现方式或希望改进的地方"></textarea>
              <small class="field-hint" id="feedback-editor-fallback-hint">可直接输入文本，Markdown 编辑器不可用时仍可提交。</small>
            </div>
            <div class="markdown-editor user-markdown-editor" id="feedback-content-editor"></div>
            <button class="button secondary" id="feedback-toggle-editor" type="button" hidden>使用普通文本编辑</button>
            <input type="hidden" name="content" id="feedback-content-value" />
            <small class="field-hint" id="feedback-content-hint">最短允许 5 字，最多 2000 字；审核通过后才会公开。</small>
          </div>
          <label class="admin-field">
            <span>联系方式（可选）</span>
            <input name="contact" maxlength="120" placeholder="邮箱、QQ 或其他联系方式" autocomplete="off" />
            <small class="field-hint">只供管理员联系核对，公开页不会展示联系方式。</small>
          </label>
          <input class="review-honeypot" name="website" tabindex="-1" autocomplete="off" />
          <div class="filter-row">
            <button class="button" id="feedback-submit" type="submit">提交反馈</button>
            <button class="button secondary" id="close-feedback-form" type="button">取消</button>
            <span class="muted" id="feedback-submit-status" role="status" aria-live="polite"></span>
          </div>
        </form>
      </div>
    </div>
  </section>

  <style is:global>
    .feedback-page .review-head, .feedback-page .filter-row, .feedback-page .pagination { flex-wrap: wrap; }
    .feedback-page .admin-field, .feedback-page .review-form, .feedback-page .markdown-editor { min-width: 0; max-width: 100%; }
    .feedback-page .review-card, .feedback-page .markdown-body, .feedback-page #feedback-submit-status { overflow-wrap: anywhere; }
    .feedback-page .feedback-login-link { padding: 0; border: 0; background: none; color: inherit; text-decoration: underline; cursor: pointer; font: inherit; }
    .feedback-page .feedback-load-error { display: grid; gap: 10px; justify-items: start; }
    .feedback-page .vditor-toolbar { flex-wrap: wrap; }
    .feedback-page .vditor-reset { overflow-wrap: anywhere; }
    .feedback-page .vditor-reset pre { max-width: 100%; overflow-x: auto; }
    @media (max-width: 420px) { .feedback-page .header-actions { width: 100%; flex-wrap: wrap; } .feedback-page .header-actions .button { flex: 1 1 100%; } }
  </style>

  <script>
    import Vditor from "vditor";
    import MarkdownIt from "markdown-it";
    import { normalizeMarkdown } from "../lib/markdown";
    import { requestUserJson } from "../lib/user-submissions-controller.js";

    const markdown = new MarkdownIt({ html: false, linkify: true, breaks: true });
    const pageSize = 10;
    const titleEl = document.querySelector("#feedback-title");
    const announcementEl = document.querySelector("#feedback-announcement");
    const list = document.querySelector("#feedback-list");
    const pagination = document.querySelector("#feedback-pagination");
    const openButton = document.querySelector("#open-feedback-form");
    const closeButton = document.querySelector("#close-feedback-form");
    const panel = document.querySelector("#feedback-submit-panel");
    const form = document.querySelector("#feedback-form");
    const statusEl = document.querySelector("#feedback-submit-status");
    const contentEditorNode = document.querySelector<HTMLElement>("#feedback-content-editor");
    const contentValue = document.querySelector<HTMLInputElement>("#feedback-content-value");
    const basicEditor = document.querySelector<HTMLTextAreaElement>("#feedback-basic-content");
    const basicPanel = document.querySelector<HTMLElement>("#feedback-basic-panel");
    const toggleEditorButton = document.querySelector<HTMLButtonElement>("#feedback-toggle-editor");
    let advancedEditorVisible = false;
    let saving = false;
    let loadFailed = false;
    let feedback = [];
    let visibleFeedbackItems = [];
    let currentPage = 1;
    let searchKeyword = "";
    let filterStatus = "all";
    const statusFilterOptions = [
      { value: "all", label: "全部" },
      { value: "open", label: "待处理" },
      { value: "processing", label: "处理中" },
      { value: "completed", label: "已完成" },
      { value: "rejected", label: "不予完成" },
      { value: "parked", label: "搁置" },
    ];
    const beijingDate = (value) => {
      const date = new Date(value || "");
      if (!value || Number.isNaN(date.getTime())) return "";
      const shifted = new Date(date.getTime() + 8 * 60 * 60 * 1000);
      return `${shifted.getUTCFullYear()}-${String(shifted.getUTCMonth() + 1).padStart(2, "0")}-${String(shifted.getUTCDate()).padStart(2, "0")}`;
    };
    let contentEditor: {
      getValue(): string;
      setValue(value: string): void;
      disabled(): void;
      enable(): void;
    } | null = null;
    let editorSettings = null;

    const statusLabel: Record<string, string> = { open: "待处理", processing: "处理中", pending: "待处理", completed: "已完成", rejected: "不予完成", parked: "搁置" };
    const handlingStatus = (item: { handlingStatus?: string; status?: string }) => item.handlingStatus || (item.status === "pending" ? "open" : item.status) || "open";
    const typeLabel = { bug: "Bug", feature: "功能改进", content: "内容问题" };
    const escapeHtml = (value) => String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
    const markdownToHtml = (value = "") => markdown.render(normalizeMarkdown(value));

    function toolbarFor(mode = "user") {
      const source = editorSettings?.[mode]?.toolbar;
      const toolbar = Array.isArray(source) && source.length
        ? source
        : ["bold", "italic", "strike", "headings", "link", "list", "ordered-list", "check", "quote", "code", "line", "table", "preview", "fullscreen"];
      if (mode !== "user") {
        const firstSafe = ["bold", "italic", "strike", "link", "list", "ordered-list", "check"];
        return [
          ...firstSafe.filter((item) => toolbar.includes(item)),
          ...toolbar.filter((item) => !firstSafe.includes(item)),
        ];
      }
      const publicAllowed = ["preview", "fullscreen", "link", "list", "ordered-list", "check", "quote", "code", "line", "table"];
      const ordered = publicAllowed.filter((item) => toolbar.includes(item));
      return ordered.length ? ordered : ["preview", "fullscreen"];
    }

    async function loadEditorSettings() {
      try {
        const data = await requestUserJson("/editor-settings");
        editorSettings = data.data || null;
      } catch {
        editorSettings = null;
      }
    }

    function enhanceVditorToolbar(root) {
      const labels = {
        bold: "粗体 Ctrl+B",
        italic: "斜体 Ctrl+I",
        strike: "删除线",
        headings: "标题",
        link: "链接",
        list: "无序列表",
        "ordered-list": "有序列表",
        check: "任务列表",
        quote: "引用",
        code: "代码块",
        line: "分割线",
        table: "表格",
        preview: "预览",
        fullscreen: "全屏",
      };
      const blurToolbar = () => root.querySelectorAll(".vditor-toolbar button").forEach((button) => button.blur());
      root.querySelectorAll(".vditor-toolbar button").forEach((button) => {
        const type = button.dataset?.type || "";
        const label = button.getAttribute("aria-label") || labels[type] || button.title;
        if (label) {
          button.title = label;
          button.setAttribute("aria-label", label);
        }
        button.tabIndex = -1;
        button.addEventListener("focus", () => window.setTimeout(() => button.blur(), 0));
        button.addEventListener("mousedown", () => window.setTimeout(() => button.blur(), 0));
      });
      root.addEventListener("pointerdown", (event) => {
        if (!event.target?.closest?.(".vditor-toolbar")) window.setTimeout(blurToolbar, 0);
      });
    }

    function mountContentEditor() {
      if (!contentEditorNode || contentEditor) return;
      const fallback = () => {
        if (advancedEditorVisible) return;
        contentEditorNode.hidden = true;
        if (basicPanel) basicPanel.hidden = false;
        const hint = document.querySelector("#feedback-editor-fallback-hint");
        if (hint) hint.textContent = "Markdown 编辑器未就绪，可继续使用普通文本编辑并提交。";
      };
      const fallbackTimer = window.setTimeout(fallback, 8000);
      try {
        contentEditor = new Vditor(contentEditorNode, {
        mode: "sv",
        value: "",
        height: 220,
        placeholder: "请描述出现位置、复现方式或希望改进的地方",
        cache: { enable: false },
        toolbar: toolbarFor("user"),
        toolbarConfig: { pin: false },
        preview: {
          actions: ["desktop", "tablet", "mobile"],
          markdown: {
            breaks: true,
          } as IMarkdownConfig & { breaks: boolean },
        },
        after() {
          window.clearTimeout(fallbackTimer);
          const value = String(basicEditor?.value || contentValue?.value || "");
          if (value) contentEditor?.setValue?.(value);
          advancedEditorVisible = true;
          contentEditorNode.hidden = false;
          if (basicPanel) basicPanel.hidden = true;
          if (toggleEditorButton) toggleEditorButton.hidden = false;
          enhanceVditorToolbar(contentEditorNode);
          contentEditorNode.querySelector("textarea")?.setAttribute("aria-label", "反馈内容");
          if (saving) contentEditor?.disabled?.();
          if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
        },
        input(value) {
          if (!advancedEditorVisible) return;
          if (contentValue) contentValue.value = value;
          if (basicEditor) basicEditor.value = value;
        },
        });
      } catch {
        window.clearTimeout(fallbackTimer);
        fallback();
      }
    }

    basicEditor?.addEventListener("input", () => { if (contentValue) contentValue.value = basicEditor.value; });
    toggleEditorButton?.addEventListener("click", () => {
      if (advancedEditorVisible) {
        if (basicEditor) basicEditor.value = contentEditor?.getValue?.() || String(contentValue?.value || "");
      } else {
        contentEditor?.setValue?.(basicEditor?.value || "");
      }
      advancedEditorVisible = !advancedEditorVisible;
      if (contentEditorNode) contentEditorNode.hidden = !advancedEditorVisible;
      if (basicPanel) basicPanel.hidden = advancedEditorVisible;
      toggleEditorButton.textContent = advancedEditorVisible ? "使用普通文本编辑" : "使用 Markdown 编辑器";
    });

    function renderPagination(total) {
      const pages = Math.max(1, Math.ceil(total / pageSize));
      currentPage = Math.min(currentPage, pages);
      pagination.hidden = total <= pageSize;
      pagination.innerHTML = "";
      if (total <= pageSize) return;
      const prev = document.createElement("button");
      prev.className = "button secondary";
      prev.type = "button";
      prev.textContent = "上一页";
      prev.disabled = currentPage === 1;
      prev.addEventListener("click", () => { currentPage -= 1; renderFeedback(); });
      const next = document.createElement("button");
      next.className = "button secondary";
      next.type = "button";
      next.textContent = "下一页";
      next.disabled = currentPage === pages;
      next.addEventListener("click", () => { currentPage += 1; renderFeedback(); });
      const label = document.createElement("span");
      label.className = "muted";
      label.textContent = `第 ${currentPage} / ${pages} 页，共 ${total} 条`;
      pagination.append(prev, label, next);
    }

    function applyFeedbackFilters() {
      const keyword = searchKeyword.trim().toLowerCase();
      visibleFeedbackItems = feedback.filter((item) => {
        if (filterStatus !== "all" && handlingStatus(item) !== filterStatus) return false;
        if (!keyword) return true;
        return [item.title, item.content, item.reply].filter(Boolean).join(" ").toLowerCase().includes(keyword);
      });
      currentPage = 1;
    }

    function renderStatusFilter() {
      const wrap = document.querySelector("#feedback-status-filter");
      wrap.innerHTML = "";
      for (const option of statusFilterOptions) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "button" + (filterStatus === option.value ? "" : " secondary");
        chip.style.minHeight = "32px";
        chip.style.fontSize = "13px";
        chip.textContent = option.label;
        chip.addEventListener("click", () => {
          filterStatus = option.value;
          applyFeedbackFilters();
          renderStatusFilter();
          renderFeedback();
        });
        wrap.append(chip);
      }
    }

    function renderFeedback() {
      if (loadFailed) return;
      if (!visibleFeedbackItems.length) {
        list.innerHTML = `<p class="empty">${searchKeyword.trim() ? `没有匹配「${escapeHtml(searchKeyword.trim())}」的反馈。` : "还没有公开反馈。"}</p>`;
        pagination.hidden = true;
        return;
      }
      const start = (currentPage - 1) * pageSize;
      const pageItems = visibleFeedbackItems.slice(start, start + pageSize);
      list.innerHTML = pageItems.map((item) => `
        <article class="review-card">
          <div class="course-meta">
            <span class="pill">${escapeHtml(typeLabel[item.type] || item.type || "反馈")}</span>
            <span class="pill">${escapeHtml(statusLabel[handlingStatus(item)] || handlingStatus(item))}</span>
          </div>
          <h3 style="margin: 12px 0 0;">${escapeHtml(item.title)}</h3>
          <div class="markdown-body">${markdownToHtml(item.content)}</div>
          ${item.reply ? `<div class="review-announcement" style="margin-top: 10px;">
            <div class="course-meta"><span class="pill">管理员回复</span></div>
            <div class="markdown-body">${markdownToHtml(item.reply)}</div>
            <small class="muted">${escapeHtml(beijingDate(item.repliedAt))}</small>
          </div>` : ""}
          <small class="muted">${escapeHtml(beijingDate(item.createdAt))}</small>
        </article>
      `).join("");
      renderPagination(visibleFeedbackItems.length);
    }

    async function loadFeedback() {
      try {
        const data = await requestUserJson("/feedback-api/feedback");
        if (data.ok !== true || !Array.isArray(data.items)) throw new Error("反馈列表返回结果不完整。请重试。");
        if (titleEl) titleEl.textContent = data.title || "问题与建议";
        const announcement = data.announcement || "";
        if (announcementEl) {
          announcementEl.innerHTML = markdownToHtml(announcement);
          announcementEl.hidden = !announcement;
        }
        feedback = data.items || [];
        loadFailed = false;
        const minLength = Number(data.rules?.minLength || 5);
        const contentHint = document.querySelector("#feedback-content-hint");
        if (contentHint) contentHint.textContent = `最短允许 ${minLength} 字，最多 2000 字；审核通过后才会公开。`;
      } catch (error) {
        loadFailed = true;
        const message = error instanceof Error ? error.message : "";
        if (list) list.innerHTML = `<div class="feedback-load-error"><p class="empty">${escapeHtml(message || "反馈加载失败，请重试。")}</p><button class="button secondary" id="feedback-retry" type="button">重试加载</button></div>`;
        if (pagination instanceof HTMLElement) pagination.hidden = true;
        document.querySelector("#feedback-retry")?.addEventListener("click", () => loadFeedback());
        return;
      }
      applyFeedbackFilters();
      renderStatusFilter();
      renderFeedback();
    }

    const searchInput = document.querySelector("#feedback-search");
    const searchClear = document.querySelector("#feedback-search-clear");
    searchInput?.addEventListener("input", () => {
      searchKeyword = searchInput.value;
      searchClear.hidden = !searchKeyword;
      applyFeedbackFilters();
      renderFeedback();
    });
    searchClear?.addEventListener("click", () => {
      searchKeyword = "";
      searchInput.value = "";
      searchClear.hidden = true;
      applyFeedbackFilters();
      renderFeedback();
    });

    openButton?.addEventListener("click", () => {
      panel.hidden = false;
      panel.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    closeButton?.addEventListener("click", () => { panel.hidden = true; });
    document.querySelector("#feedback-open-login")?.addEventListener("click", () => document.querySelector<HTMLDialogElement>("#auth-modal")?.showModal());
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (saving) return;
      const data = new FormData(form);
      const content = advancedEditorVisible ? contentEditor?.getValue?.() || String(contentValue?.value || "") : String(basicEditor?.value || contentValue?.value || data.get("content") || "");
      if (!content.trim()) {
        statusEl.textContent = "请先填写反馈内容。";
        return;
      }
      if (content.length > 2000) { if (statusEl) statusEl.textContent = "反馈内容最多 2000 字，请缩短后提交。输入已保留。"; return; }
      saving = true;
      const lockedFields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | HTMLButtonElement>("input,textarea,select,button")).map((field) => ({ field, disabled: field.disabled }));
      lockedFields.forEach(({ field }) => { field.disabled = true; });
      if (advancedEditorVisible) contentEditor?.disabled?.();
      statusEl.textContent = "提交中…";
      try {
        const result = await requestUserJson("/feedback-api/submit", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            type: data.get("type"),
            title: data.get("title"),
            content,
            contact: data.get("contact"),
            website: data.get("website"),
          }),
        });
        if (result.ok !== true || result.accepted !== true) throw new Error("服务器尚未确认保存，输入已保留。请稍后重试。");
        form.reset();
        if (advancedEditorVisible) contentEditor?.setValue?.("");
        if (contentValue) contentValue.value = "";
        if (basicEditor) basicEditor.value = "";
        statusEl.textContent = "已提交，等待公开审核。可在我的反馈查看处理状态和管理员回复。";
        await loadFeedback();
      } catch (error) {
        statusEl.textContent = error.message;
      } finally {
        saving = false;
        lockedFields.forEach(({ field, disabled }) => { field.disabled = disabled; });
        if (advancedEditorVisible) contentEditor?.enable?.();
      }
    });

    Promise.all([loadEditorSettings(), loadFeedback()]).then(mountContentEditor);
  </script>
</Layout>
