---
import Layout from "../layouts/Layout.astro";
import participate from "../data/participate.json";
import { markdownToHtml } from "../lib/markdown";
---

<Layout title="参与" eyebrow="Contribute">
  <section class="content">
    <article class="panel">
      <div class="panel-header">
        <h2>{participate.title}</h2>
      </div>
      <div class="panel-body">
        <div class="markdown-body" set:html={markdownToHtml(participate.content)} />
      </div>
    </article>
  </section>
</Layout>
