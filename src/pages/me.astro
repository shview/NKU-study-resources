---
import Layout from "../layouts/Layout.astro";
---

<Layout title="我的" eyebrow="Me">
  <section class="content">
    <div id="me-app" style="min-height: 400px; padding: 40px 0;">
      <div style="text-align: center; padding: 60px 0;">
        <p class="muted">正在加载…</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* JS 注入的 DOM 只能使用全局样式：全部沿用站点设计体系（panel/admin-field/button），
     这里仅补充个人中心特有的少量外观（危险按钮、状态色、列表行）。 */
  .me-scope {
    max-width: 660px;
    margin: 0 auto;
    display: grid;
    gap: 16px;
  }
  .me-summary {
    cursor: pointer;
    padding: 10px 0;
    font-weight: 750;
    color: var(--text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .me-summary::-webkit-details-marker { display: none; }
  .me-summary::before {
    content: "▸";
    color: var(--muted);
    font-size: 0.9em;
    transition: transform 0.15s ease;
  }
  details[open] > .me-summary::before { transform: rotate(90deg); }
  .me-rows { display: grid; gap: 2px; }
  .me-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 2px;
    border-bottom: 1px solid var(--line-soft);
  }
  .me-row:last-child { border-bottom: none; }
  .me-row-main { flex: 1; min-width: 0; }
  .me-row-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .me-row-main, .me-row-main strong, .me-row-main p { overflow-wrap: anywhere; }
  .me-scope .panel-header, .me-scope .filter-row, .me-scope .header-actions { flex-wrap: wrap; }
  .me-scope .panel-header > div { min-width: 0; }
  .me-row-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .me-row-chips .me-chip { white-space: normal; }
  .me-original { margin: 8px 0; }
  .me-original summary { cursor: pointer; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
  .me-original p, .me-reply p { white-space: pre-wrap; line-height: 1.65; overflow-wrap: anywhere; margin: 8px 0; }
  .me-reply { background: var(--surface-soft); border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin-top: 12px; }
  .me-reply-heading { font-size: 13px; }
  .me-list-error { display: grid; gap: 10px; justify-items: start; padding: 8px 0; }
  .me-list-error p { margin: 0; overflow-wrap: anywhere; }
  .me-pagination { display: flex; justify-content: center; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  .me-pagination[hidden] { display: none; }
  @media (max-width: 420px) { .me-scope .me-row { flex-wrap: wrap; } .me-pagination .button { flex: 1 1 100px; } }
  .me-status { font-size: 13px; font-weight: 600; }
  .me-status.ok { color: #16a34a; }
  .me-status.err { color: #dc2626; }
  .me-chip {
    flex: 0 0 auto;
    font-size: 12px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    background: var(--surface-soft);
  }
  .me-chip.ok { color: #15803d; border-color: #bbf7d0; background: #f0fdf4; }
  .me-chip.warn { color: #a16207; border-color: #fde68a; background: #fefce8; }
  .me-chip.err { color: #b91c1c; border-color: #fecaca; background: #fef2f2; }
  :root[data-theme="dark"] .me-chip.ok { color: #4ade80; border-color: #14532d; background: #0a1f0e; }
  :root[data-theme="dark"] .me-chip.warn { color: #facc15; border-color: #713f12; background: #211a05; }
  :root[data-theme="dark"] .me-chip.err { color: #f87171; border-color: #7f1d1d; background: #250d0d; }
  .button.me-danger {
    color: #b91c1c;
    border-color: #fecaca;
    background: #fef2f2;
  }
  .button.me-danger:hover { background: #fee2e2; }
  :root[data-theme="dark"] .button.me-danger {
    color: #f87171;
    border-color: #7f1d1d;
    background: #250d0d;
  }
  .me-danger-panel { border-color: #fecaca; }
  :root[data-theme="dark"] .me-danger-panel { border-color: #7f1d1d; }
</style>

<script>
  import { createOwnerListController, requestUserJson } from "../lib/user-submissions-controller.js";

  type FavoriteItem = { name: string; term?: string; resource_count?: number };
  type ReviewItem = { course_title: string; teacher_name: string; body: string; status: string; publicationState?: string; hidden?: boolean; created_at: string };
  type FeedbackItem = { title: string; content: string; type: string; status: string; private?: boolean; publicationState?: string; handlingStatus?: string; hidden?: boolean; createdAt: string; reply?: string; repliedAt?: string };

  async function api(path, options = {}) {
    const data = await requestUserJson(`/api/v1${path}`, {
      ...options,
      headers: { "content-type": "application/json", ...(options.headers || {}) },
    });
    if (data.code !== 0) throw new Error(data.message || "请求失败");
    return data.data;
  }

  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const handlingChip = (s: string): [string, string] => (({ open: ["待处理", "warn"], processing: ["处理中", "warn"], completed: ["已完成", "ok"], rejected: ["不予完成", "err"], parked: ["搁置", ""] } as Record<string, [string, string]>)[s] || ["处理状态待确认", ""]);
  const publicationChip = (s: string): [string, string] => (({ pending: ["待批准公开", "warn"], approved: ["已批准公开", "ok"], rejected: ["公开被拒绝", "err"] } as Record<string, [string, string]>)[s] || ["公开状态待确认", ""]);
  const dateText = (value: string | number) => {
    const date = new Date(value || "");
    if (!value || Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("zh-CN", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false }).format(date);
  };
  const originalText = (value: unknown) => {
    const text = String(value || "");
    return `<details class="me-original"><summary>${esc(text.slice(0, 100) || "查看提交原文")}${text.length > 100 ? "…" : ""} · 展开原文</summary><p>${esc(text)}</p></details>`;
  };
  const badge = ([label, tone]: [string, string]) => `<span class="me-chip ${tone}">${esc(label)}</span>`;

  async function init() {
    const app = document.querySelector<HTMLElement>("#me-app")!;
    app.innerHTML = '<p class="muted" role="status" style="text-align:center;padding:40px;">正在读取当前账号…</p>';
    let user = null;
    let sessionError: Error | null = null;
    // 空 web-login 请求 = 通过 httpOnly cookie 恢复会话
    try {
      const d = await api("/auth/web-login", { method: "POST", body: "{}" });
      if (d?.user?.nickname) user = d.user;
    } catch (error) { if ((error as Error & { status?: number }).status !== 401) sessionError = error as Error; }

    if (sessionError) {
      app.innerHTML = `<div class="me-scope"><div class="panel"><div class="panel-header"><h2>暂时无法读取账号</h2></div><div class="panel-body me-list-error"><p>${esc(sessionError.message || "账号加载失败，请重试。")}</p><button class="button secondary" id="me-session-retry" type="button">重试加载</button><a href="/report/">匿名私密投诉举报</a></div></div></div>`;
      document.querySelector("#me-session-retry")?.addEventListener("click", () => init());
      return;
    }

    if (!user) {
      app.innerHTML = `
        <div class="me-scope">
          <div class="panel">
            <div class="panel-header"><h2>登录后继续</h2></div>
            <div class="panel-body" style="text-align:center;">
              <p class="muted" style="margin:0 0 18px;">登录后可管理账号并查看收藏、评价和反馈</p>
              <div class="filter-row" style="justify-content:center;border-left:none;background:none;padding:0;">
                <button type="button" class="button" id="me-open-login">登录 / 注册</button>
                <a class="button secondary" href="/">返回首页</a>
                <a class="button secondary" href="/report/">匿名私密投诉举报</a>
              </div>
            </div>
          </div>
        </div>`;
      document.querySelector("#me-open-login")?.addEventListener("click", () => document.getElementById("auth-modal")?.showModal());
      return;
    }

    app.innerHTML = `
      <div class="me-scope">

        <div class="panel">
          <div class="panel-header split-header">
            <div>
              <h2 id="me-nickname">${esc(user.nickname)}</h2>
              <p class="muted" style="margin:4px 0 0;font-size:13px;">${esc(user.email || "未设置邮箱")}</p>
              <p class="muted" style="margin:6px 0 0;font-size:13px;">${user.phone_verified ? "手机号已认证，可提交公开内容。" : "手机号尚未认证，暂不能提交公开内容。认证需要微信小程序手机号授权；网页暂未提供授权或短信入口，接入问题请联系站点管理员。"}</p>
            </div>
            <div class="header-actions">
              <button type="button" class="button secondary" id="logout-btn">退出登录</button>
              <span class="me-status" id="logout-status" role="status"></span>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-header"><h2>账号设置</h2></div>
          <div class="panel-body">

            <details>
              <summary class="me-summary">修改昵称</summary>
              <form class="review-form" style="max-width:360px;padding-top:6px;">
                <label class="admin-field">
                  <span>新昵称（全局唯一，2-32 字符）</span>
                  <input id="nick-input" type="text" maxlength="32" placeholder="输入新的昵称" autocomplete="off" />
                </label>
                <div class="filter-row" style="border-left:none;background:none;padding:0;">
                  <button type="button" class="button" id="nick-save">保存昵称</button>
                  <span class="me-status" id="nick-status"></span>
                </div>
              </form>
            </details>

            <details style="margin-top:10px;">
              <summary class="me-summary">修改密码</summary>
              <form class="review-form" style="max-width:360px;padding-top:6px;">
                <label class="admin-field">
                  <span>当前密码</span>
                  <input id="pw-current" type="password" autocomplete="current-password" placeholder="正在使用的密码" />
                </label>
                <label class="admin-field">
                  <span>新密码（至少 8 位）</span>
                  <input id="pw-new" type="password" autocomplete="new-password" placeholder="新密码" />
                </label>
                <label class="admin-field">
                  <span>确认新密码（二次确认）</span>
                  <input id="pw-confirm" type="password" autocomplete="new-password" placeholder="再次输入新密码" />
                  <small class="field-hint">两次输入一致才会提交；服务端会校验当前密码。</small>
                </label>
                <div class="filter-row" style="border-left:none;background:none;padding:0;">
                  <button type="button" class="button" id="pw-save">修改密码</button>
                  <span class="me-status" id="pw-status"></span>
                </div>
              </form>
            </details>

          </div>
        </div>

        <div class="panel">
          <div class="panel-header split-header">
            <h2>我的收藏</h2>
            <span class="me-chip" id="fav-count">…</span>
          </div>
          <div class="panel-body"><div class="me-rows" id="fav-list"><p class="muted" style="padding:6px 0;">加载中…</p></div><div class="me-pagination" id="fav-pagination" hidden></div></div>
        </div>

        <div class="panel">
          <div class="panel-header split-header">
            <h2>我的评价</h2>
            <span class="me-chip" id="rev-count">…</span>
          </div>
          <div class="panel-body"><div class="me-rows" id="rev-list"><p class="muted" style="padding:6px 0;">加载中…</p></div><div class="me-pagination" id="rev-pagination" hidden></div></div>
        </div>

        <div class="panel">
          <div class="panel-header split-header">
            <h2>我的反馈</h2>
            <span class="me-chip" id="fb-count">…</span>
          </div>
          <div class="panel-body"><p class="field-hint">仅展示提交时关联本账号的记录。匿名投诉举报不会出现在账号列表中。<a href="/report/">提交私密投诉举报</a></p><div class="me-rows" id="fb-list"><p class="muted" style="padding:6px 0;">加载中…</p></div><div class="me-pagination" id="fb-pagination" hidden></div></div>
        </div>

        <div class="panel me-danger-panel">
          <div class="panel-header"><h2 style="color:#dc2626;">危险操作</h2></div>
          <div class="panel-body">
            <details>
              <summary class="me-summary" style="color:#dc2626;">注销账号</summary>
              <form class="review-form" style="max-width:420px;padding-top:6px;">
                <p class="field-hint" style="margin:0;">注销将删除登录方式与收藏，已发布的评价和反馈内容会保留但解除关联。此操作不可撤销。</p>
                <label class="admin-field">
                  <span>请输入「注销」以确认</span>
                  <input id="del-confirm" type="text" placeholder="注销" autocomplete="off" />
                </label>
                <div class="filter-row" style="border-left:none;background:none;padding:0;">
                  <button type="button" class="button me-danger" id="del-btn" disabled>永久注销账号</button>
                  <span class="me-status" id="del-status"></span>
                </div>
              </form>
            </details>
          </div>
        </div>

      </div>`;

    // —— 修改昵称（二次确认）——
    document.querySelector("#nick-save")?.addEventListener("click", async () => {
      const status = document.querySelector("#nick-status");
      const nickname = document.querySelector("#nick-input").value.trim();
      status.className = "me-status";
      if (nickname.length < 2) { status.textContent = "昵称至少 2 个字符"; status.classList.add("err"); return; }
      if (nickname === user.nickname) { status.textContent = "昵称未变化"; return; }
      if (!confirm(`确定将昵称改为「${nickname}」？`)) return;
      status.textContent = "保存中…";
      try {
        const d = await api("/me/profile", { method: "POST", body: JSON.stringify({ nickname }) });
        user.nickname = d.user.nickname;
        document.querySelector("#me-nickname").textContent = d.user.nickname;
        status.classList.add("ok"); status.textContent = "已更新";
      } catch (e) { status.classList.add("err"); status.textContent = e.message; }
    });

    // —— 修改密码（两次输入 + 当前密码校验）——
    document.querySelector("#pw-save")?.addEventListener("click", async () => {
      const status = document.querySelector("#pw-status");
      const current = document.querySelector("#pw-current").value;
      const next = document.querySelector("#pw-new").value;
      const confirm2 = document.querySelector("#pw-confirm").value;
      status.className = "me-status";
      if (!current) { status.textContent = "请输入当前密码"; status.classList.add("err"); return; }
      if (next.length < 8) { status.textContent = "新密码至少 8 位"; status.classList.add("err"); return; }
      if (next !== confirm2) { status.textContent = "两次输入的新密码不一致"; status.classList.add("err"); return; }
      if (!confirm("确定修改密码？修改后需使用新密码登录。")) return;
      status.textContent = "提交中…";
      try {
        await api("/me/web-password/change", { method: "POST", body: JSON.stringify({ current_password: current, new_password: next }) });
        document.querySelector("#pw-current").value = "";
        document.querySelector("#pw-new").value = "";
        document.querySelector("#pw-confirm").value = "";
        status.classList.add("ok"); status.textContent = "密码已修改";
      } catch (e) { status.classList.add("err"); status.textContent = e.message; }
    });

    // —— 注销（输入「注销」双重确认）——
    document.querySelector("#del-confirm")?.addEventListener("input", (e) => {
      document.querySelector("#del-btn").disabled = e.target.value.trim() !== "注销";
    });
    document.querySelector("#del-btn")?.addEventListener("click", async () => {
      const status = document.querySelector("#del-status");
      if (!confirm("最后确认：真的要永久注销账号吗？此操作不可撤销。")) return;
      status.className = "me-status"; status.textContent = "处理中…";
      try {
        await api("/me/delete-account", { method: "POST", body: "{}" });
        location.href = "/";
      } catch (e) { status.classList.add("err"); status.textContent = e.message; }
    });

    // —— 列表加载 ——
    function mountList<T>({ prefix, path, unit, empty, renderItem }: { prefix: string; path: string; unit: string; empty: string; renderItem: (item: T) => string }) {
      const count = document.querySelector<HTMLElement>(`#${prefix}-count`)!;
      const list = document.querySelector<HTMLElement>(`#${prefix}-list`)!;
      const pager = document.querySelector<HTMLElement>(`#${prefix}-pagination`)!;
      const controller = createOwnerListController({ path, pageSize: 10, onState(state) {
        if (state.phase === "loading") {
          list.innerHTML = '<p class="muted" role="status">加载中…</p>';
          count.textContent = "加载中";
          pager.querySelectorAll("button").forEach((button) => { button.disabled = true; });
          return;
        }
        if (state.phase === "error") {
          count.textContent = "未加载";
          pager.hidden = true;
          list.innerHTML = `<div class="me-list-error" role="alert"><p>${esc(state.error)}</p><div class="filter-row"><button class="button secondary" data-list-retry type="button">重试加载</button>${state.authExpired ? '<button class="button" data-list-login type="button">重新登录</button>' : ""}</div></div>`;
          list.querySelector("[data-list-retry]")?.addEventListener("click", () => controller.retry());
          list.querySelector("[data-list-login]")?.addEventListener("click", () => document.querySelector<HTMLDialogElement>("#auth-modal")?.showModal());
          return;
        }
        if (state.phase !== "ready") return;
        count.textContent = `共 ${state.total} ${unit}`;
        list.innerHTML = state.items.length ? (state.items as T[]).map(renderItem).join("") : `<p class="muted">${esc(empty)}</p>`;
        const pages = Math.max(1, Math.ceil(state.total / state.pageSize));
        pager.hidden = pages <= 1;
        pager.innerHTML = "";
        if (pages <= 1) return;
        const previous = document.createElement("button");
        previous.type = "button";
        previous.className = "button secondary";
        previous.textContent = "上一页";
        previous.disabled = state.page <= 1;
        previous.addEventListener("click", () => controller.load(state.page - 1));
        const next = document.createElement("button");
        next.type = "button";
        next.className = "button secondary";
        next.textContent = "下一页";
        next.disabled = state.page >= pages;
        next.addEventListener("click", () => controller.load(state.page + 1));
        const label = document.createElement("span");
        label.className = "field-hint";
        label.textContent = `第 ${state.page} / ${pages} 页，共 ${state.total} ${unit}`;
        pager.append(previous, label, next);
      } });
      return controller.load();
    }

    mountList<FavoriteItem>({ prefix: "fav", path: "/api/v1/me/favorites", unit: "门", empty: "暂无收藏", renderItem: (f) => `
      <div class="me-row"><a class="me-row-main" href="/courses/${encodeURIComponent(f.name)}/" style="color:inherit;text-decoration:none;font-weight:700;">${esc(f.name)}</a><span class="muted" style="font-size:12px;">${esc(f.term || "")} · ${Number(f.resource_count) || 0} 份资料</span></div>` });

    mountList<ReviewItem>({ prefix: "rev", path: "/api/v1/me/reviews", unit: "条", empty: "暂无评价", renderItem: (r) => `
      <article class="me-row"><div class="me-row-main"><div class="me-row-top"><strong>${esc(r.course_title)} · ${esc(r.teacher_name)}</strong><div class="me-row-chips">${badge(publicationChip(r.publicationState || r.status))}${r.hidden ? badge(["已隐藏", "err"]) : ""}</div></div>${originalText(r.body)}<time class="field-hint" datetime="${esc(r.created_at)}">提交于 ${esc(dateText(r.created_at))}</time></div></article>` });

    mountList<FeedbackItem>({ prefix: "fb", path: "/api/v1/me/feedback", unit: "条", empty: "暂无反馈或已关联的投诉举报", renderItem: (f) => {
      const isPrivate = f.private === true || ["report", "complaint"].includes(f.type);
      const publication = f.publicationState || (["pending", "approved", "rejected"].includes(f.status) ? f.status : "");
      const handling = f.handlingStatus || (["open", "processing", "completed", "rejected", "parked"].includes(f.status) ? f.status : "open");
      return `<article class="me-row"><div class="me-row-main"><div class="me-row-top"><strong>${esc(f.title)}</strong><div class="me-row-chips">${badge(handlingChip(handling))}${isPrivate ? badge(["始终私密", ""]) : badge(publicationChip(publication))}${f.hidden ? badge(["已隐藏", "err"]) : ""}</div></div>${originalText(f.content)}<time class="field-hint" datetime="${esc(f.createdAt)}">提交于 ${esc(dateText(f.createdAt))}</time>${f.reply ? `<div class="me-reply"><strong class="me-reply-heading">管理员回复</strong><p>${esc(f.reply)}</p>${f.repliedAt ? `<time class="field-hint" datetime="${esc(f.repliedAt)}">回复于 ${esc(dateText(f.repliedAt))}</time>` : ""}</div>` : ""}</div></article>`;
    } });

    // —— 退出登录 ——
    document.querySelector("#logout-btn")?.addEventListener("click", async () => {
      if (!confirm("确定退出登录？")) return;
      const button = document.querySelector<HTMLButtonElement>("#logout-btn");
      const status = document.querySelector<HTMLElement>("#logout-status")!;
      if (button) button.disabled = true;
      try {
        await api("/auth/logout", { method: "POST", body: "{}" });
        location.href = "/";
      } catch (error) {
        status.textContent = (error as Error).message || "退出登录失败，请重试。";
        status.classList.add("err");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  init().catch(() => {
    document.querySelector("#me-app").innerHTML = '<p style="text-align:center;padding:40px;">加载失败，请刷新重试。</p>';
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) init().catch(() => { document.querySelector("#me-app").innerHTML = '<p role="alert">账号加载失败，请刷新重试。</p>'; });
  });
</script>
