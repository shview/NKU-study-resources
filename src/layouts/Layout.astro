---
import "../styles/global.css";
import { readBuildData } from "../lib/runtime-data";
import { markdownToHtml } from "../lib/markdown";

type Props = {
  title?: string;
  eyebrow?: string;
};

const { title = "NKUStudy", eyebrow } = Astro.props;
const footerConfig = readBuildData("footer.json");
const nav = [
  { href: "/", label: "首页", icon: "home" },
  { href: "/courses/", label: "课程", icon: "book" },
  { href: "/reviews/", label: "评价", icon: "star" },
  { href: "/participate/", label: "参与", icon: "spark" },
  { href: "/feedback/", label: "反馈", icon: "message" },
  { href: "/friends/", label: "友链", icon: "link" },
  { href: "/about/", label: "关于", icon: "info" },
];
const icons = {
  home: '<svg viewBox="0 0 24 24"><path d="m4 11 8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-6h4v6"/></svg>',
  book: '<svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v15H6.5A2.5 2.5 0 0 0 4 21.5v-15Z"/><path d="M8 8h8M8 12h6"/></svg>',
  star: '<svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>',
  spark: '<svg viewBox="0 0 24 24"><path d="M12 3l1.7 5.2L19 10l-5.3 1.8L12 17l-1.7-5.2L5 10l5.3-1.8L12 3Z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z"/></svg>',
  message: '<svg viewBox="0 0 24 24"><path d="M5 5h14v10H8l-3 3V5Z"/><path d="M8 9h8M8 12h5"/></svg>',
  link: '<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1 0l-2 2A5 5 0 0 0 12 20.1l1.1-1.1"/></svg>',
  info: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 10v6M12 7.5v.1"/></svg>',
};
const currentPath = Astro.url.pathname;
const footer = {
  enabled: footerConfig.enabled === true,
  showVisitCount: footerConfig.showVisitCount !== false,
  useRealVisitCount: footerConfig.useRealVisitCount === true,
  visitCount: footerConfig.visitCount || "0",
  startedAt: footerConfig.startedAt || "2022-01-01T00:00:00+08:00",
  copyrightText: footerConfig.copyrightText || `\u00a9 ${footerConfig.copyrightYear || "2025"} NKUStudy`,
  maintainers: Array.isArray(footerConfig.maintainers)
    ? footerConfig.maintainers
        .map((item) => ({
          label: item?.label,
          url: /^(null|undefined)$/i.test(String(item?.url || "").trim()) ? "" : item?.url,
        }))
        .filter((item) => item.label)
    : [],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NKUStudy - 南开课程评价与学习资源导航。" />
    <title>{title === "NKUStudy" ? title : `${title} | NKUStudy`}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("nkustudy-theme");
        const prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? "dark" : "light");
      })();
    </script>
  </head>
  <body>
    <div class="app-shell" id="app-shell">
      <aside class="sidebar">
        <div class="brand-row">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true" set:html={icons.book} />
            <span class="brand-text">
              <strong>NKUStudy</strong>
              <small>Course Resources</small>
            </span>
          </a>
          <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="收拢侧边栏" title="收拢侧边栏">‹</button>
        </div>
        <nav class="side-nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) }}>
              <span class="nav-icon" set:html={icons[item.icon]} />
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
        </nav>
      </aside>
      <main class="main">
        <header class="topbar">
          <div>
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h1>{title}</h1>
          </div>
          <div class="top-actions">
            <a class="top-link" href="/me/" id="user-link" style="display:none;">我的</a>
            <button class="top-link" id="login-btn" type="button" style="display:none;" onclick="document.getElementById('auth-modal').showModal()">登录</button>
            <button class="theme-toggle top-link" id="theme-toggle" type="button" aria-label="切换明暗色" title="切换明暗色">
              <span class="theme-icon theme-icon-sun" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              </span>
              <span class="theme-icon theme-icon-moon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z"/></svg>
              </span>
            </button>
            <a class="top-link" href="https://pan.shview.top" target="_blank" rel="noreferrer">OpenList</a>
          </div>
        </header>
        <slot />
        {footer.enabled && (
          <footer class="site-footer" data-started-at={footer.startedAt} data-real-visits={String(footer.useRealVisitCount)}>
            {footer.showVisitCount && <p>本站总访问量：<span id="site-visit-count">{footer.visitCount}</span> 次</p>}
            <p>本站已安全运行 <span id="site-runtime">计算中</span></p>
            {footer.copyrightText && <div class="markdown-body footer-markdown" set:html={markdownToHtml(footer.copyrightText)} />}
            {footer.maintainers.length > 0 && (
              <p>
                Maintainer:
                <span class="footer-maintainers">
                  {footer.maintainers.map((item) => (
                    item.url ? <a href={item.url} target="_blank" rel="noreferrer">{item.label}</a> : <span>{item.label}</span>
                  ))}
                </span>
              </p>
            )}
          </footer>
        )}
      </main>
      <dialog id="auth-modal" style="border:1px solid var(--line);border-radius:16px;padding:32px;max-width:400px;background:var(--surface);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
          <strong style="font-size:1.2em;">账号</strong>
          <button type="button" onclick="document.getElementById('auth-modal').close()" style="border:none;background:none;font-size:1.4em;cursor:pointer;color:inherit;">×</button>
        </div>
        <div id="auth-login-form">
          <label style="display:block;margin-bottom:12px;"><span style="display:block;font-size:0.85em;margin-bottom:4px;">昵称</span><input id="auth-nickname" type="text" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:inherit;" placeholder="你的昵称" /></label>
          <label style="display:block;margin-bottom:16px;"><span style="display:block;font-size:0.85em;margin-bottom:4px;">密码</span><input id="auth-password" type="password" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:inherit;" placeholder="密码" /></label>
          <button type="button" id="auth-login-submit" style="width:100%;padding:10px;border:none;border-radius:8px;background:#4B1F6F;color:#fff;font-weight:700;cursor:pointer;">登录</button>
          <p style="text-align:center;margin-top:12px;font-size:0.85em;"><a href="#" id="auth-show-register" style="color:#4B1F6F;">没有账号？注册</a></p>
          <p style="text-align:center;font-size:0.78em;color:var(--muted);margin-top:8px;">忘记密码？请通过<a href="/feedback/" style="color:inherit;">问题反馈</a>联系管理员重置</p>
        </div>
        <div id="auth-register-form" style="display:none;">
          <label style="display:block;margin-bottom:12px;"><span style="display:block;font-size:0.85em;margin-bottom:4px;">昵称（全局唯一）</span><input id="reg-nickname" type="text" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:inherit;" placeholder="你的昵称" /></label>
          <label style="display:block;margin-bottom:12px;"><span style="display:block;font-size:0.85em;margin-bottom:4px;">密码（至少 8 位）</span><input id="reg-password" type="password" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:inherit;" placeholder="密码" /></label>
          <label style="display:block;margin-bottom:16px;"><span style="display:block;font-size:0.85em;margin-bottom:4px;">确认密码</span><input id="reg-password2" type="password" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:inherit;" placeholder="再次输入" /></label>
          <p style="font-size:0.78em;color:var(--muted);margin-bottom:12px;">忘记密码？请通过<a href="/feedback/" style="color:inherit;">问题反馈</a>联系管理员重置</p>
          <button type="button" id="auth-register-submit" style="width:100%;padding:10px;border:none;border-radius:8px;background:#4B1F6F;color:#fff;font-weight:700;cursor:pointer;">注册</button>
          <p style="text-align:center;margin-top:12px;font-size:0.85em;"><a href="#" id="auth-show-login" style="color:#4B1F6F;">已有账号？登录</a></p>
        </div>
        <p id="auth-status" style="text-align:center;font-size:0.85em;color:#dc2626;margin-top:8px;"></p>
      </dialog>
      <script>
        (async () => {
          const loginBtn = document.querySelector("#login-btn");
          const userLink = document.querySelector("#user-link");
          const status = document.querySelector("#auth-status");
          try {
            const r = await fetch("/api/v1/auth/web-login", { method: "POST", headers: { "content-type": "application/json" }, body: "{}" });
            if (r.ok) {
              const d = await r.json();
              if (d.data?.user?.nickname) {
                loginBtn.textContent = d.data.user.nickname;
                loginBtn.style.display = "";
                loginBtn.onclick = () => location.href = "/me/";
                userLink.style.display = "";
                return;
              }
            }
          } catch {}
          loginBtn.style.display = "";
        })();
        document.querySelector("#auth-show-register")?.addEventListener("click", (e) => { e.preventDefault(); document.querySelector("#auth-login-form").style.display = "none"; document.querySelector("#auth-register-form").style.display = ""; });
        document.querySelector("#auth-show-login")?.addEventListener("click", (e) => { e.preventDefault(); document.querySelector("#auth-register-form").style.display = "none"; document.querySelector("#auth-login-form").style.display = ""; });
        document.querySelector("#auth-login-submit")?.addEventListener("click", async () => {
          const status = document.querySelector("#auth-status");
          status.textContent = "";
          try {
            const r = await fetch("/api/v1/auth/web-login", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ nickname: document.querySelector("#auth-nickname").value, password: document.querySelector("#auth-password").value }) });
            const d = await r.json();
            if (!r.ok || d.code !== 0) { status.textContent = d.message || "登录失败"; return; }
            location.href = "/me/";
          } catch { status.textContent = "网络错误"; }
        });
        document.querySelector("#auth-register-submit")?.addEventListener("click", async () => {
          const status = document.querySelector("#auth-status");
          status.textContent = "";
          const pw = document.querySelector("#reg-password").value;
          const pw2 = document.querySelector("#reg-password2").value;
          if (pw !== pw2) { status.textContent = "两次密码不一致"; return; }
          try {
            const r = await fetch("/api/v1/auth/web-register", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ nickname: document.querySelector("#reg-nickname").value, password: pw }) });
            const d = await r.json();
            if (!r.ok || d.code !== 0) { status.textContent = d.message || "注册失败"; return; }
            location.href = "/me/";
          } catch { status.textContent = "网络错误"; }
        });
      </script>
    </div>
    <script>
      const shell = document.querySelector("#app-shell");
      const sidebarToggle = document.querySelector("#sidebar-toggle");
      const themeToggle = document.querySelector("#theme-toggle");
      const systemTheme = window.matchMedia?.("(prefers-color-scheme: dark)");
      const updateThemeButton = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-label", dark ? "切换为亮色" : "切换为暗色");
        themeToggle?.setAttribute("title", dark ? "切换为亮色" : "切换为暗色");
      };
      const isNarrowScreen = window.matchMedia?.("(max-width: 900px)").matches;
      const storedCollapsed = localStorage.getItem("nkustudy-sidebar-collapsed");
      // 窄屏默认收起，用户点开过才展开；宽屏保持记忆、默认展开。
      const collapsed = isNarrowScreen ? storedCollapsed !== "false" : storedCollapsed === "true";
      if (collapsed) {
        shell?.setAttribute("data-sidebar-collapsed", "true");
        sidebarToggle?.setAttribute("aria-label", "展开侧边栏");
        sidebarToggle?.setAttribute("title", "展开侧边栏");
        if (sidebarToggle) sidebarToggle.textContent = "›";
      }
      sidebarToggle?.addEventListener("click", () => {
        const next = shell?.getAttribute("data-sidebar-collapsed") !== "true";
        if (next) {
          shell?.setAttribute("data-sidebar-collapsed", "true");
          sidebarToggle.textContent = "›";
          sidebarToggle.setAttribute("aria-label", "展开侧边栏");
          sidebarToggle.setAttribute("title", "展开侧边栏");
        } else {
          shell?.removeAttribute("data-sidebar-collapsed");
          sidebarToggle.textContent = "‹";
          sidebarToggle.setAttribute("aria-label", "收拢侧边栏");
          sidebarToggle.setAttribute("title", "收拢侧边栏");
        }
        localStorage.setItem("nkustudy-sidebar-collapsed", String(next));
      });
      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("nkustudy-theme", next);
        updateThemeButton();
      });
      systemTheme?.addEventListener("change", (event) => {
        if (localStorage.getItem("nkustudy-theme")) return;
        document.documentElement.dataset.theme = event.matches ? "dark" : "light";
        updateThemeButton();
      });

      const runtimeEl = document.querySelector("#site-runtime");
      const footer = document.querySelector(".site-footer");
      const parseStartedAt = (value) => {
        const normalized = String(value || "")
          .trim()
          .replace(" ", "T")
          .replace(/T0(\d{2}:\d{2}(?::\d{2})?)/, "T$1");
        return new Date(normalized);
      };
      const formatRuntime = () => {
        if (!runtimeEl || !footer) return;
        const started = parseStartedAt(footer.getAttribute("data-started-at") || "");
        if (Number.isNaN(started.getTime())) {
          runtimeEl.textContent = "起始时间格式错误";
          return;
        }
        let seconds = Math.floor((Date.now() - started.getTime()) / 1000);
        if (seconds < 0) {
          runtimeEl.textContent = "起始时间晚于当前时间";
          return;
        }
        const years = Math.floor(seconds / (365 * 24 * 60 * 60));
        seconds -= years * 365 * 24 * 60 * 60;
        const days = Math.floor(seconds / (24 * 60 * 60));
        seconds -= days * 24 * 60 * 60;
        const hours = Math.floor(seconds / (60 * 60));
        seconds -= hours * 60 * 60;
        const minutes = Math.floor(seconds / 60);
        seconds -= minutes * 60;
        runtimeEl.textContent = `${years} 年 ${days} 天 ${hours} 小时 ${minutes} 分 ${seconds} 秒`;
      };
      formatRuntime();
      window.setInterval(formatRuntime, 1000);

      const updateVisitCount = async () => {
        const countEl = document.querySelector("#site-visit-count");
        if (!countEl || footer?.dataset.realVisits !== "true") return;
        try {
          const response = await fetch("/visit-api/stats", { cache: "no-store" });
          const data = await response.json();
          if (data.ok && data.stats) countEl.textContent = String(data.stats.total ?? countEl.textContent);
        } catch {}
      };
      const sendVisitHit = () => {
        if (location.pathname.startsWith("/admin")) return;
        const payload = JSON.stringify({ path: location.pathname });
        if (navigator.sendBeacon) {
          navigator.sendBeacon("/visit-api/hit", new Blob([payload], { type: "application/json" }));
          return;
        }
        fetch("/visit-api/hit", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: payload,
          keepalive: true,
        }).catch(() => {});
      };
      sendVisitHit();
      updateVisitCount();
      updateThemeButton();
    </script>
  </body>
</html>
